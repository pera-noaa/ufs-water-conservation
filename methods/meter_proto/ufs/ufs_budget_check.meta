[ccpp-table-properties]
  name = ufs_budget_check
  type = scheme
  dependencies = ../../hooks/machine.F,ufs_budget_common.F90

[ccpp-arg-table]
  name = ufs_budget_check_run
  type = scheme
[im]
  standard_name = horizontal_loop_extent
  long_name = horizontal loop extent
  units = count
  dimensions = ()
  type = integer
  intent = in
[levs]
  standard_name = vertical_layer_dimension
  long_name = vertical layer dimension
  units = count
  dimensions = ()
  type = integer
  intent = in
[ntqv]
  standard_name = index_of_specific_humidity_in_tracer_concentration_array
  long_name = tracer index for water vapor
  units = index
  dimensions = ()
  type = integer
  intent = in
[ntcw]
  standard_name = index_of_cloud_liquid_water_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for cloud condensate
  units = index
  dimensions = ()
  type = integer
  intent = in
[ntiw]
  standard_name = index_of_cloud_ice_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for ice water
  units = index
  dimensions = ()
  type = integer
  intent = in
[ntrw]
  standard_name = index_of_rain_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for rain water
  units = index
  dimensions = ()
  type = integer
  intent = in
[ntsw]
  standard_name = index_of_snow_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for snow water
  units = index
  dimensions = ()
  type = integer
  intent = in
[ntgl]
  standard_name = index_of_graupel_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for graupel
  units = index
  dimensions = ()
  type = integer
  intent = in
[nthl]
  standard_name = index_of_hail_mixing_ratio_in_tracer_concentration_array
  long_name = tracer index for hail
  units = index
  dimensions = ()
  type = integer
  intent = in
[dtp]
  standard_name = timestep_for_physics
  long_name = physics time step
  units = s
  dimensions = ()
  type = real
  kind = kind_phys
  intent = in
[con_g]
  standard_name = gravitational_acceleration
  long_name = gravitational acceleration
  units = m s-2
  dimensions = ()
  type = real
  kind = kind_phys
  intent = in
[gq0]
  standard_name = tracer_concentration
  long_name = tracer concentration
  units = kg kg-1
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,number_of_tracers)
  type = real
  kind = kind_phys
  intent = in
[dqdt]
  standard_name = process_split_cumulative_tendency_of_tracers
  long_name = tendency of the tracers due to model physics
  units = kg kg-1 s-1
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,number_of_tracers)
  type = real
  kind = kind_phys
  intent = in
[prsi]
  standard_name = air_pressure_at_interface
  long_name = air pressure at model layer interfaces
  units = Pa
  dimensions = (horizontal_loop_extent,vertical_interface_dimension)
  type = real
  kind = kind_phys
  intent = in
[w0]
  standard_name = budget_column_water_at_segment_start
  long_name = column water at the start of the checked segment
  units = kg m-2
  dimensions = (horizontal_loop_extent)
  type = real
  kind = kind_phys
  intent = inout
[flux]
  standard_name = budget_declared_column_water_change_of_segment
  long_name = declared column water change of the checked segment
  units = kg m-2
  dimensions = (horizontal_loop_extent)
  type = real
  kind = kind_phys
  intent = in
[dw]
  standard_name = budget_accumulated_column_water_change_of_segment
  long_name = column water change of the checked segment, window sum
  units = kg m-2
  dimensions = (horizontal_loop_extent)
  type = real
  kind = kind_phys
  intent = inout
[decl]
  standard_name = budget_accumulated_declared_water_change_of_segment
  long_name = declared water change of the checked segment, window sum
  units = kg m-2
  dimensions = (horizontal_loop_extent)
  type = real
  kind = kind_phys
  intent = inout
[errmsg]
  standard_name = ccpp_error_message
  long_name = error message for error handling in CCPP
  units = none
  dimensions = ()
  type = character
  kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  long_name = error code for error handling in CCPP
  units = 1
  dimensions = ()
  type = integer
  intent = out
