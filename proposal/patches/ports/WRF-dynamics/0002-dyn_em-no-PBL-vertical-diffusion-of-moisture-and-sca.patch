From 7413e45ffa5229c2c3b8c718d8d203783bcbd74e Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Wed, 14 Oct 2026 21:13:52 -0600
Subject: [PATCH 2/3] dyn_em: no-PBL vertical diffusion of moisture and scalars
 conserves mass

What was wrong: vertical_diffusion_mp (qv) and the 'm' branch of
vertical_diffusion (every other moist species, scalar, chem and tracer), used
with diff_opt=1 and bl_pbl_physics=0, set vflux(0)=vflux(1): the ground flux
equalled the first interior flux, so the lowest layer kept whatever it sent
upward and water was created. The tendency
g*g/((c1*MUT+c2)*alt)*rdnw*(vflux(k)-vflux(k-1)) also put rho/mu of the cell
outside the flux difference, so it did not telescope even with zero end
fluxes.

Fix: vflux becomes the mass flux through the w level, times g*rho/mu averaged
from the two layers (K*rho*dq/dz in the coupled frame); vflux(0)=0, no flux
through the ground; the tendency is g*rdnw*(vflux(k)-vflux(k-1)), the form
vertical_diffusion_s already uses. Conserved: sum over each column of
(c1h*mu+c2h)*dnw*q/g; sum_k (-dnw/g)*T = vflux(0)-vflux(ktf) = 0. Same K and
gradient (of q-qv_base for qv); the continuum operator is now exactly
(mu/rho) d/dz(K rho dq/dz), the old one dropped the d(rho/mu)/deta term.

Measured in em_quarter_ss (as above), diff_opt=1 km_opt=4 no PBL, domain
water change outside the microphysics as a fraction of precipitation:
+0.923 -> -5.4e-6 (domain total +0.930 -> +1.66e-2; the rest is inside the
Thompson step, which is then +1.66e-2 vs +6.8e-3 before). kvdif=0 and
bl_pbl_physics=1 give bit-identical output to the unfixed build. Storm at 2 h:
precipitation 2.81 -> 2.78 kg/m2, max w 30.5 -> 30.0 m/s, coldest surface
theta' -4.4 -> -5.9 K (the old run had 0.93 P of extra water).

AI-assisted: written with Claude Code (Anthropic); reviewed by the author.
---
 dyn_em/module_big_step_utilities_em.F | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/dyn_em/module_big_step_utilities_em.F b/dyn_em/module_big_step_utilities_em.F
index 597908a4..aa7422de 100644
--- a/dyn_em/module_big_step_utilities_em.F
+++ b/dyn_em/module_big_step_utilities_em.F
@@ -3162,11 +3162,14 @@ j_loop_s : DO j = j_start, j_end
        DO i = i_start, i_end
          vflux(i,k)=kvdif*rdn(k+1)/(0.5*(alt(i,k,j)+alt(i,k+1,j)))   &
                   *(field(i,k+1,j)-field(i,k,j))
+         ! mass flux: times g*rho/mu at the w level, so the tendency below telescopes
+         vflux(i,k)=vflux(i,k)*g*0.5*(1./((c1(k  )*MUT(i,j)+c2(k  ))*alt(i,k  ,j))    &
+                                     +1./((c1(k+1)*MUT(i,j)+c2(k+1))*alt(i,k+1,j)))
        ENDDO
      ENDDO
 
      DO i = i_start, i_end
-       vflux(i,0)=vflux(i,1)
+       vflux(i,0)=0.   ! no flux through the ground
      ENDDO
 
      DO i = i_start, i_end
@@ -3175,8 +3178,7 @@ j_loop_s : DO j = j_start, j_end
 
      DO k=kts,ktf
        DO i = i_start, i_end
-         tendency(i,k,j)=tendency(i,k,j)+g*g/(c1(k)*MUT(i,j)+c2(k))/alt(i,k,j)  &
-                *rdnw(k)*(vflux(i,k)-vflux(i,k-1))
+         tendency(i,k,j)=tendency(i,k,j)+g*rdnw(k)*(vflux(i,k)-vflux(i,k-1))
        ENDDO
      ENDDO
 
@@ -3258,11 +3260,14 @@ j_loop_s : DO j = j_start, j_end
        DO i = i_start, i_end
          vflux(i,k)=kvdif*rdn(k+1)/(0.5*(alt(i,k,j)+alt(i,k+1,j)))   &
                     *(field(i,k+1,j)-field(i,k,j)-base(k+1)+base(k))
+         ! mass flux: times g*rho/mu at the w level, so the tendency below telescopes
+         vflux(i,k)=vflux(i,k)*g*0.5*(1./((c1(k  )*MUT(i,j)+c2(k  ))*alt(i,k  ,j))    &
+                                     +1./((c1(k+1)*MUT(i,j)+c2(k+1))*alt(i,k+1,j)))
        ENDDO
      ENDDO
 
      DO i = i_start, i_end
-       vflux(i,0)=vflux(i,1)
+       vflux(i,0)=0.   ! no flux through the ground
      ENDDO
 
      DO i = i_start, i_end
@@ -3271,8 +3276,7 @@ j_loop_s : DO j = j_start, j_end
 
      DO k=kts,ktf
        DO i = i_start, i_end
-         tendency(i,k,j)=tendency(i,k,j)+g*g/(c1(k)*MUT(i,j)+c2(k))/alt(i,k,j)  &
-                *rdnw(k)*(vflux(i,k)-vflux(i,k-1))
+         tendency(i,k,j)=tendency(i,k,j)+g*rdnw(k)*(vflux(i,k)-vflux(i,k-1))
        ENDDO
      ENDDO
 
