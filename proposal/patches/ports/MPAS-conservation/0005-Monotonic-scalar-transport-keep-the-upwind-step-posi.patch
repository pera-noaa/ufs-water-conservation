+   !-----------------------------------------------------------------------
+   !  routine atm_upwind_vert_renorm
+   !
+   !> \brief   Keeps the upwind (low-order) update of the monotonic transport positive definite
+   !> \details The upwind update of a layer stays non-negative only while its total upwind outflow, horizontal
+   !>          plus vertical, is at most its content; with a vertical Courant number above 1 it is not. For
+   !>          each layer whose outflow exceeds its content, the vertical upwind fluxes leaving it are scaled
+   !>          by (content - horizontal outflow)/(vertical outflow), as in Skamarock (2006, MWR 134, 2241-2250).
+   !>          Each face is scaled by its donor layer's factor, so the update stays conservative; a column is
+   !>          left unchanged, bit for bit, where no layer's outflow exceeds its content. The horizontal fluxes
+   !>          are not scaled (that would need the factors of halo cells); a layer whose horizontal outflow
+   !>          alone exceeds its content (horizontal Courant number above 1) is not made positive.
+   !>          mass(k): rho_zz_old*scalar_old; outh(k): horizontal upwind outflow (same units);
+   !>          ww(k): wwAvg at w level k; flux(k): dt * upwind vertical flux at w level k = 2..nz (inout).
+   !-----------------------------------------------------------------------
+   subroutine atm_upwind_vert_renorm(nz, mass, outh, ww, rdnw, flux)
+
+      !$acc routine seq
+
+      implicit none
+
+      integer, intent(in) :: nz
+      real (kind=RKIND), dimension(nz), intent(in) :: mass, outh, rdnw
+      real (kind=RKIND), dimension(nz+1), intent(in) :: ww
+      real (kind=RKIND), dimension(nz), intent(inout) :: flux
+
+      integer :: k
+      real (kind=RKIND) :: outv, r
+
+      do k = 1, nz
+         outv = 0.0_RKIND
+         if (k < nz) then
+            if (ww(k+1) > 0.0_RKIND) outv = outv + flux(k+1)
+         end if
+         if (k > 1) then
+            if (ww(k) < 0.0_RKIND) outv = outv - flux(k)
+         end if
+         outv = outv * rdnw(k)
+         if (outv > 0.0_RKIND .and. outh(k) + outv > mass(k)) then
+            r = max(0.0_RKIND, mass(k) - outh(k)) / outv
+            if (k < nz) then
+               if (ww(k+1) > 0.0_RKIND) flux(k+1) = flux(k+1) * r
+            end if
+            if (k > 1) then
+               if (ww(k) < 0.0_RKIND) flux(k) = flux(k) * r
+            end if
+         end if
+      end do
+
+   end subroutine atm_upwind_vert_renorm
+
+
    subroutine atm_compute_dyn_tend(tend, tend_physics, state, diag, mesh, diag_physics, configs, nVertLevels, rk_step, dynamics_substep, dt, &
