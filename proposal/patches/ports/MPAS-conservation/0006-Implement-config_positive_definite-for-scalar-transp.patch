+   !-----------------------------------------------------------------------
+   !  function atm_pd_factor
+   !
+   !> \brief   Positive-definite flux factor of one cell (Skamarock 2006)
+   !> \details Returns content/outgoing where the total outgoing flux exceeds the cell's content (0 for a cell
+   !>          without content), and exactly 1 otherwise. Both arguments in the same units (mass per volume).
+   !-----------------------------------------------------------------------
+   real (kind=RKIND) function atm_pd_factor(content, outgoing)
+
+      !$acc routine seq
+
+      implicit none
+
+      real (kind=RKIND), intent(in) :: content, outgoing
+
+      if (outgoing > content .and. outgoing > 0.0_RKIND) then
+         atm_pd_factor = max(0.0_RKIND, content) / outgoing
+      else
+         atm_pd_factor = 1.0_RKIND
+      end if
+
+   end function atm_pd_factor
+
