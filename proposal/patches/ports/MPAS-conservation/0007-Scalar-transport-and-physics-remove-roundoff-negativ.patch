+   !-----------------------------------------------------------------------
+   !  routine atm_nonneg_column
+   !
+   !> \brief   Removes negative values from one column of a scalar without changing the column mass
+   !> \details wt(k) is the mass per unit mixing ratio of layer k (rho_zz/rdzw). use_max selects the plain clip
+   !>          this replaces: max(0,q) (true) or q = 0 where q < 0 (false). On return, status is
+   !>            0  no negative value: the plain clip was applied, which changes nothing but what it always did
+   !>               (bit for bit the old result)
+   !>            1  mode NONNEG_BORROW: the negative values were set to zero and the same mass taken from the
+   !>               column's positive values in proportion to their mass (NCEP Office Note 506, eqs. 10-11)
+   !>            2  mode NONNEG_CLIP, or a column without positive mass to borrow from: the plain clip was
+   !>               applied, and added is the mass it adds
+   !>            3  a non-finite value or a weight that is not positive and finite: the plain clip was applied
+   !>               (NaN and Inf propagate as they did) and added = 0, so no non-finite value is returned
+   !-----------------------------------------------------------------------
+   subroutine atm_nonneg_column(nz, q, wt, mode, use_max, added, status)
+
+      !$acc routine seq
+
+      implicit none
+
+      integer, intent(in) :: nz
+      real (kind=RKIND), dimension(nz), intent(inout) :: q
+      real (kind=RKIND), dimension(nz), intent(in) :: wt
+      integer, intent(in) :: mode
+      logical, intent(in) :: use_max
+      real (kind=RKIND), intent(out) :: added
+      integer, intent(out) :: status
+
+      integer :: k
+      logical :: valid
+      real (kind=RKIND) :: pos, neg, fac
+
+      pos = 0.0_RKIND
+      neg = 0.0_RKIND
+      valid = .true.
+      do k = 1, nz
+         ! .not. (abs(x) <= huge(x)) is true for NaN and for +-Inf
+         if (.not. (abs(q(k)) <= huge(q(k))) .or. .not. (abs(wt(k)) <= huge(wt(k))) .or. .not. (wt(k) > 0.0_RKIND)) &
+            valid = .false.
+         if (q(k) < 0.0_RKIND) then
+            neg = neg + q(k)*wt(k)
+         else
+            pos = pos + q(k)*wt(k)
+         end if
+      end do
+      if (.not. (abs(pos) <= huge(pos)) .or. .not. (abs(neg) <= huge(neg))) valid = .false.
+
+      added = 0.0_RKIND
+      status = 0
+      if (.not. valid) then
+         status = 3
+      else if (neg < 0.0_RKIND) then
+         if (mode == NONNEG_BORROW .and. pos + neg > 0.0_RKIND) then
+            fac = (pos + neg) / pos
+            do k = 1, nz
+               if (q(k) < 0.0_RKIND) then
+                  q(k) = 0.0_RKIND
+               else
+                  q(k) = q(k) * fac
+               end if
+            end do
+            status = 1
+            return
+         end if
+         added = -neg
+         status = 2
+      end if
+
+      ! the plain clip (statuses 0, 2 and 3)
+      if (use_max) then
+         do k = 1, nz
+            q(k) = max(0.0_RKIND, q(k))
+         end do
+      else
+         do k = 1, nz
+            if (q(k) < 0.0_RKIND) q(k) = 0.0_RKIND
+         end do
+      end if
+
+   end subroutine atm_nonneg_column
+
