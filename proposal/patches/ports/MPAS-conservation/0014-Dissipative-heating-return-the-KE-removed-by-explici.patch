+
+   subroutine edis_setup(domain)
+      type (domain_type), intent(in) :: domain
+      type (mpas_pool_type), pointer :: mesh, diag
+      integer, pointer :: p, nCells, nEdges, nVertLevels
+      call mpas_pool_get_subpool(domain % blocklist % structs, 'mesh', mesh)
+      call mpas_pool_get_subpool(domain % blocklist % structs, 'diag', diag)
+      call mpas_pool_get_dimension(mesh, 'nCellsSolve', p); edis_nCellsSolve = p
+      call mpas_pool_get_dimension(mesh, 'nEdgesSolve', p); edis_nEdgesSolve = p
+      call mpas_pool_get_dimension(mesh, 'nCells', nCells)
+      call mpas_pool_get_dimension(mesh, 'nEdges', nEdges)
+      call mpas_pool_get_dimension(mesh, 'nVertLevels', nVertLevels)
+      call mpas_pool_get_array(mesh, 'areaCell', edis_area)
+      call mpas_pool_get_array(mesh, 'rdzu', edis_rdzu)
+      call mpas_pool_get_array(mesh, 'rdzw', edis_rdzw)
+      call mpas_pool_get_array(mesh, 'dcEdge', edis_dc)
+      call mpas_pool_get_array(mesh, 'dvEdge', edis_dv)
+      call mpas_pool_get_array(diag, 'edis_wu', edis_wu)
+      call mpas_pool_get_array(diag, 'edis_wd', edis_wd)
+      edis_wu(:,:) = 0.0_RKIND
+      edis_wd(:,:) = 0.0_RKIND
+      allocate(edis_ww(nVertLevels+1,nCells+1,2), edis_tu(nVertLevels,nEdges+1))
+      edis_ww(:,:,:) = 0.d0
+      if (edis_opt /= 2) return
+      call mpas_pool_get_dimension(mesh, 'vertexDegree', p); edis_vdeg = p
+      call mpas_pool_get_array(mesh, 'cellsOnEdge', edis_coe)
+      call mpas_pool_get_array(mesh, 'verticesOnEdge', edis_voe)
+      call mpas_pool_get_array(mesh, 'edgesOnCell', edis_eoc)
+      call mpas_pool_get_array(mesh, 'verticesOnCell', edis_voc)
+      call mpas_pool_get_array(mesh, 'cellsOnVertex', edis_cov)
+      call mpas_pool_get_array(mesh, 'nEdgesOnCell', edis_neoc)
+      call mpas_pool_get_array(mesh, 'kiteAreasOnVertex', edis_kite)
+      call mpas_pool_get_array(mesh, 'areaTriangle', edis_atri)
+      call mpas_pool_get_array(mesh, 'invDcEdge', edis_idc)
+      call mpas_pool_get_array(mesh, 'invDvEdge', edis_idv)
+      call mpas_pool_get_array(mesh, 'meshScalingDel2', edis_ms2)
+      call mpas_pool_get_array(mesh, 'meshScalingDel4', edis_ms4)
+      allocate(edis_pc(nVertLevels,nCells+1,6), edis_w2(nVertLevels,nEdges+1))
+      edis_pc(:,:,:) = 0.d0
+      edis_w2(:,:) = 0.d0
+   end subroutine edis_setup
+
+   subroutine edis_work_u(tend_u_euler, u, dcEdge, dvEdge, rdzw, nVertLevels, nEdges, es, ee)
+      ! KE work of u_dissipation_3d on each owned edge layer
+      integer, intent(in) :: nVertLevels, nEdges, es, ee
+      real (kind=RKIND), dimension(nVertLevels,nEdges+1), intent(in) :: tend_u_euler, u
+      real (kind=RKIND), dimension(nEdges+1), intent(in) :: dcEdge, dvEdge
+      real (kind=RKIND), dimension(nVertLevels), intent(in) :: rdzw
+      integer :: iEdge, k
+      do iEdge = es, min(ee, edis_nEdgesSolve)
+         do k = 1, nVertLevels
+            edis_wu(k,iEdge) = edis_wu(k,iEdge) + real(dble(dcEdge(iEdge))*dble(dvEdge(iEdge))/dble(rdzw(k)) &
+                *dble(u(k,iEdge))*(dble(tend_u_euler(k,iEdge)) - dble(edis_tu(k,iEdge)))*edis_dtdyn, RKIND)
+         end do
+      end do
+   end subroutine edis_work_u
+
+   subroutine edis_work_w(tend_w_euler, w, invAreaCell, rdzu, nVertLevels, nCells, cs, ce)
+      ! KE work of w_dissipation_3d on each owned interface (it zeroes tend_w_euler first: its output is all of it)
+      integer, intent(in) :: nVertLevels, nCells, cs, ce
+      real (kind=RKIND), dimension(nVertLevels+1,nCells+1), intent(in) :: tend_w_euler, w
+      real (kind=RKIND), dimension(nCells+1), intent(in) :: invAreaCell
+      real (kind=RKIND), dimension(nVertLevels+1), intent(in) :: rdzu
+      integer :: iCell, k
+      do iCell = cs, min(ce, edis_nCellsSolve)
+         do k = 2, nVertLevels
+            edis_ww(k,iCell,1) = edis_ww(k,iCell,1) + dble(w(k,iCell))*dble(tend_w_euler(k,iCell)) &
+                                 /dble(rdzu(k))/dble(invAreaCell(iCell))*edis_dtdyn
+         end do
+      end do
+   end subroutine edis_work_w
+
+   subroutine edis_work_dd(state, diag, mesh, coef_divdamp, dts, es, ee)
+      ! KE work of one acoustic substep's 3-d divergence damping on each owned edge layer; option 2 density per cell
+      type (mpas_pool_type), intent(in) :: state, diag, mesh
+      real (kind=RKIND), intent(in) :: coef_divdamp, dts
+      integer, intent(in) :: es, ee
+      real (kind=RKIND), dimension(:,:), pointer :: theta_m, rtheta_pp, rtheta_pp_old, u, rho_zz
+      real (kind=RKIND), dimension(:), pointer :: specZoneMaskEdge
+      integer, dimension(:,:), pointer :: cellsOnEdge
+      integer :: iEdge, iCell, j, k, c1, c2
+      real (kind=8) :: dcm, d
+      call mpas_pool_get_array(mesh, 'cellsOnEdge', cellsOnEdge)
+      call mpas_pool_get_array(mesh, 'specZoneMaskEdge', specZoneMaskEdge)
+      call mpas_pool_get_array(state, 'theta_m', theta_m, 1)
+      call mpas_pool_get_array(state, 'u', u, 2)
+      call mpas_pool_get_array(diag, 'rtheta_pp', rtheta_pp)
+      call mpas_pool_get_array(diag, 'rtheta_pp_old', rtheta_pp_old)
+      do iEdge = es, min(ee, edis_nEdgesSolve)
+         c1 = cellsOnEdge(1,iEdge); c2 = cellsOnEdge(2,iEdge)
+         do k = 1, size(u,1)
+            edis_wd(k,iEdge) = edis_wd(k,iEdge) + real(dble(edis_dc(iEdge))*dble(edis_dv(iEdge))/dble(edis_rdzw(k)) &
+                *dble(u(k,iEdge))*dble(coef_divdamp) &
+                *(dble(rtheta_pp_old(k,c2) - rtheta_pp(k,c2)) - dble(rtheta_pp_old(k,c1) - rtheta_pp(k,c1))) &
+                *(1.d0 - dble(specZoneMaskEdge(iEdge)))/dble(theta_m(k,c1) + theta_m(k,c2)), RKIND)
+         end do
+      end do
+      if (edis_opt /= 2 .or. es /= 1) return   ! one pass over the owned cells
+      call mpas_pool_get_array(state, 'rho_zz', rho_zz, 1)
+      do iCell = 1, edis_nCellsSolve
+         dcm = 0.d0
+         do j = 1, edis_neoc(iCell)
+            dcm = dcm + dble(edis_dc(edis_eoc(j,iCell)))
+         end do
+         dcm = dcm/dble(edis_neoc(iCell))
+         do k = 1, size(u,1)
+            d = dble(rtheta_pp_old(k,iCell)) - dble(rtheta_pp(k,iCell))
+            edis_pc(k,iCell,5) = edis_pc(k,iCell,5) + dble(edis_area(iCell))/dble(edis_rdzw(k))*dcm*dble(coef_divdamp) &
+                                 *d**2/(2.d0*dble(dts)*dble(rho_zz(k,iCell))*dble(theta_m(k,iCell))**2)
+         end do
+      end do
+   end subroutine edis_work_dd
+
+   subroutine edis_work_wd(iCell, rwp0, rwp1, w, nVertLevels, dss, zz, rho_zz, fzm, fzp, dts)
+      ! KE work of one acoustic substep's implicit w damping on each interface of an owned cell; option 2 density
+      integer, intent(in) :: iCell, nVertLevels
+      real (kind=RKIND), intent(in) :: rwp0(:), rwp1(:), w(:), dss(:), zz(:), rho_zz(:), fzm(:), fzp(:), dts
+      integer :: k
+      real (kind=8) :: g, p
+      if (iCell > edis_nCellsSolve) return
+      do k = 2, nVertLevels
+         edis_ww(k,iCell,2) = edis_ww(k,iCell,2) + dble(w(k))*(dble(rwp1(k)) - dble(rwp0(k)))/dble(edis_rdzu(k)) &
+                              *dble(edis_area(iCell))
+      end do
+      if (edis_opt /= 2) return
+      do k = 2, nVertLevels
+         g = dble(dts)*dble(dss(k))/(1.d0 + dble(dts)*dble(dss(k)))
+         p = dble(edis_area(iCell))/dble(edis_rdzu(k))*g*(dble(fzm(k))*dble(zz(k)) + dble(fzp(k))*dble(zz(k-1))) &
+             *(dble(fzm(k))*dble(rho_zz(k)) + dble(fzp(k))*dble(rho_zz(k-1)))*dble(w(k))**2
+         edis_pc(k-1,iCell,6) = edis_pc(k-1,iCell,6) + 0.5d0*p
+         edis_pc(k,iCell,6) = edis_pc(k,iCell,6) + 0.5d0*p
+      end do
+   end subroutine edis_work_wd
+
+   subroutine edis_pd_u(u, divergence, vorticity, rho_edge, rho_zz, nu, visc4, f4, rdzw, nVertLevels, nCells, nEdges, &
+                        nVertices, cs, ce, es, ee)
+      ! option 2: u del2 work per owned edge; u del2 and del4 densities on each owned cell layer
+      integer, intent(in) :: nVertLevels, nCells, nEdges, nVertices, cs, ce, es, ee
+      real (kind=RKIND), dimension(nVertLevels,nEdges+1), intent(in) :: u, rho_edge
+      real (kind=RKIND), dimension(nVertLevels,nCells+1), intent(in) :: divergence, rho_zz, nu
+      real (kind=RKIND), dimension(nVertLevels,nVertices+1), intent(in) :: vorticity
+      real (kind=RKIND), intent(in) :: visc4, f4
+      real (kind=RKIND), dimension(nVertLevels), intent(in) :: rdzw
+      integer :: iEdge, iCell, iv, i, j, k, c1, c2, v1, v2
+      real (kind=8) :: rdc, rdv, kite, cv, gd, rz
+      do iEdge = es, min(ee, edis_nEdgesSolve)
+         c1 = edis_coe(1,iEdge); c2 = edis_coe(2,iEdge); v1 = edis_voe(1,iEdge); v2 = edis_voe(2,iEdge)
+         rdc = dble(edis_idc(iEdge)); rdv = min(dble(edis_idv(iEdge)), 4.d0*rdc)
+         do k = 1, nVertLevels
+            edis_w2(k,iEdge) = edis_w2(k,iEdge) + dble(edis_dc(iEdge))*dble(edis_dv(iEdge))/dble(rdzw(k)) &
+               *dble(u(k,iEdge))*dble(rho_edge(k,iEdge))*0.5d0*(dble(nu(k,c1)) + dble(nu(k,c2)))*dble(edis_ms2(iEdge)) &
+               *((dble(divergence(k,c2)) - dble(divergence(k,c1)))*rdc - (dble(vorticity(k,v2)) - dble(vorticity(k,v1)))*rdv) &
+               *edis_dtdyn
+         end do
+      end do
+      do iCell = cs, min(ce, edis_nCellsSolve)
+         do k = 1, nVertLevels
+            edis_pc(k,iCell,1) = edis_pc(k,iCell,1) + dble(rho_zz(k,iCell))*dble(nu(k,iCell))*dble(edis_area(iCell)) &
+                                 *dble(divergence(k,iCell))**2/dble(rdzw(k))*edis_dtdyn
+         end do
+         do j = 1, edis_neoc(iCell)
+            iv = edis_voc(j,iCell)
+            kite = 0.d0
+            do i = 1, edis_vdeg
+               if (edis_cov(i,iv) == iCell) kite = dble(edis_kite(i,iv))
+            end do
+            iEdge = edis_eoc(j,iCell)
+            c1 = edis_coe(1,iEdge); c2 = edis_coe(2,iEdge); v1 = edis_voe(1,iEdge); v2 = edis_voe(2,iEdge)
+            rdc = dble(edis_idc(iEdge)); rdv = min(dble(edis_idv(iEdge)), 4.d0*rdc)
+            do k = 1, nVertLevels
+               cv = 0.d0
+               do i = 1, edis_vdeg
+                  cv = cv + dble(edis_kite(i,iv))*dble(rho_zz(k,edis_cov(i,iv)))*dble(nu(k,edis_cov(i,iv)))
+               end do
+               cv = cv/dble(edis_atri(iv))
+               edis_pc(k,iCell,1) = edis_pc(k,iCell,1) + cv*kite*dble(vorticity(k,iv))**2/dble(rdzw(k))*edis_dtdyn
+               if (visc4 > 0.0_RKIND) then
+                  gd = (dble(divergence(k,c2)) - dble(divergence(k,c1)))*rdc
+                  rz = (dble(vorticity(k,v2)) - dble(vorticity(k,v1)))*rdv
+                  edis_pc(k,iCell,2) = edis_pc(k,iCell,2) + 0.5d0*dble(rho_edge(k,iEdge))*dble(visc4)*dble(edis_ms4(iEdge)) &
+                     *dble(edis_dc(iEdge))*dble(edis_dv(iEdge))/dble(rdzw(k))*(dble(f4)*gd**2 + rz**2)*edis_dtdyn
+               end if
+            end do
+         end do
+      end do
+   end subroutine edis_pd_u
+
+   subroutine edis_pd_w(w, rho_edge, rho_zz, nu, delsq_w, visc4, rdzu, nVertLevels, nCells, nEdges, cs, ce)
+      ! option 2: w del2 (exact, per edge, half to each cell) and del4 densities; each interface's half to each layer
+      integer, intent(in) :: nVertLevels, nCells, nEdges, cs, ce
+      real (kind=RKIND), dimension(nVertLevels+1,nCells+1), intent(in) :: w
+      real (kind=RKIND), dimension(nVertLevels,nEdges+1), intent(in) :: rho_edge
+      real (kind=RKIND), dimension(nVertLevels,nCells+1), intent(in) :: rho_zz, nu, delsq_w
+      real (kind=RKIND), intent(in) :: visc4
+      real (kind=RKIND), dimension(nVertLevels), intent(in) :: rdzu
+      integer :: iCell, iEdge, j, k, c1, c2
+      real (kind=8) :: r, p
+      do iCell = cs, min(ce, edis_nCellsSolve)
+         do j = 1, edis_neoc(iCell)
+            iEdge = edis_eoc(j,iCell)
+            c1 = edis_coe(1,iEdge); c2 = edis_coe(2,iEdge)
+            r = dble(edis_dv(iEdge))*dble(edis_idc(iEdge))*dble(edis_ms2(iEdge))
+            do k = 2, nVertLevels
+               p = 0.5d0*r*0.5d0*(dble(rho_edge(k,iEdge)) + dble(rho_edge(k-1,iEdge))) &
+                   *0.25d0*(dble(nu(k,c1)) + dble(nu(k,c2)) + dble(nu(k-1,c1)) + dble(nu(k-1,c2))) &
+                   *(dble(w(k,c2)) - dble(w(k,c1)))**2/dble(rdzu(k))*edis_dtdyn
+               edis_pc(k-1,iCell,3) = edis_pc(k-1,iCell,3) + 0.5d0*p
+               edis_pc(k,iCell,3) = edis_pc(k,iCell,3) + 0.5d0*p
+            end do
+         end do
+         if (visc4 > 0.0_RKIND) then
+            do k = 2, nVertLevels
+               p = dble(visc4)*dble(edis_area(iCell))*dble(delsq_w(k,iCell))**2 &
+                   /(0.5d0*(dble(rho_zz(k,iCell)) + dble(rho_zz(k-1,iCell))))/dble(rdzu(k))*edis_dtdyn
+               edis_pc(k-1,iCell,4) = edis_pc(k-1,iCell,4) + 0.5d0*p
+               edis_pc(k,iCell,4) = edis_pc(k,iCell,4) + 0.5d0*p
+            end do
+         end if
+      end do
+   end subroutine edis_pd_w
+
+   subroutine edis_apply(domain, dt, itimestep)
+      ! return the step's KE work as heat. Option 1: half of each edge's to each of its cells, half of each interface's to
+      ! each layer. Option 2: each term's positive density, rescaled so that its domain sum is the term's work
+      type (domain_type), intent(inout) :: domain   ! halo exchange
+      real (kind=RKIND), intent(in) :: dt
+      integer, intent(in) :: itimestep
+      real (kind=RKIND), dimension(:,:), pointer :: rho_zz, theta_m, zz, zgrid, u, w
+      real (kind=RKIND), dimension(:,:,:), pointer :: scalars
+      real (kind=RKIND), dimension(:), pointer :: rdzw, areaCell, dcEdge, dvEdge
+      integer, dimension(:,:), pointer :: edgesOnCell
+      integer, dimension(:), pointer :: nEdgesOnCell
+      real (kind=RKIND), dimension(:,:), pointer :: rtheta_p, rtheta_b, exner, exner_b, pressure_p, rt_diab
+      integer :: nCellsSolve, nVertLevels, ms, me, iq(6), iCell, iEdge, k, j, n
+      integer (kind=8) :: acc(ebud_nd, 9), ac2(ebud_nd, 11)
+      real (kind=8) :: tot(9), t2(11), sc(6), q(4), col, dm, ex, tm, rate, rmax, rmin, gmax, gmin, g0(15), g1(15)
+      real (kind=8), allocatable :: qc(:,:,:)
+      logical :: met
+      call mpas_dmpar_field_halo_exch(domain, 'edis_wu')
+      call mpas_dmpar_field_halo_exch(domain, 'edis_wd')
+      call ebud_ptrs(domain, 2, nCellsSolve, nVertLevels, ms, me, iq, rho_zz, theta_m, scalars, u, w, &
+                     zz, zgrid, rdzw, areaCell, dcEdge, dvEdge, edgesOnCell, nEdgesOnCell)
+      call efix_ptrs(domain, rtheta_p, rtheta_b, exner, exner_b, pressure_p, rt_diab)
+      met = ebud_meter_on(domain)
+      if (met) call ebud_global(domain, 2, g0)
+      allocate(qc(4,nVertLevels,nCellsSolve))
+      acc(:,:) = 0_8
+      ac2(:,:) = 0_8
+      do iCell = 1, nCellsSolve   ! option 1 heat (J/m2)
+         col = 0.d0
+         do k = 1, nVertLevels
+            q(:) = 0.d0
+            do j = 1, nEdgesOnCell(iCell)
+               q(1) = q(1) - 0.5d0*dble(edis_wu(k,edgesOnCell(j,iCell)))
+               q(2) = q(2) - 0.5d0*dble(edis_wd(k,edgesOnCell(j,iCell)))
+            end do
+            q(3) = -0.5d0*(edis_ww(k,iCell,1) + edis_ww(k+1,iCell,1))
+            q(4) = -0.5d0*(edis_ww(k,iCell,2) + edis_ww(k+1,iCell,2))
+            q(:) = q(:)/dble(areaCell(iCell))
+            qc(:,k,iCell) = q(:)
+            col = col + sum(q)
+            if (edis_opt == 2) then
+               do n = 1, 4
+                  call ebud_radd(ac2(:,n), q(n)*dble(areaCell(iCell)))
+               end do
+               do n = 1, 6
+                  call ebud_radd(ac2(:,4+n), edis_pc(k,iCell,n))
+               end do
+            end if
+         end do
+         if (edis_opt == 2) call ebud_rnorm(ac2, 10)
+         if (met .and. col < 0.d0) then
+            call ebud_radd(acc(:,8), 1.d0)
+            call ebud_radd(acc(:,9), col*dble(areaCell(iCell)))
+         end if
+      end do
+      if (edis_opt == 2) then
+         do iEdge = 1, edis_nEdgesSolve
+            do k = 1, nVertLevels
+               call ebud_radd(ac2(:,11), -edis_w2(k,iEdge))
+            end do
+            call ebud_rnorm(ac2(:,11:11), 1)
+         end do
+         call ebud_rsum(domain, 11, ac2, t2)
+         ! t2: option 1 heat u, dd, w, wd; densities u2, u4, w2, w4, dd, wd; u del2 heat
+         sc(1) = edis_ratio(t2(11), t2(5))
+         sc(2) = edis_ratio(t2(1) - t2(11), t2(6))
+         sc(3) = 1.d0
+         sc(4) = edis_ratio(t2(3) - t2(7), t2(8))
+         sc(5) = edis_ratio(t2(2), t2(9))
+         sc(6) = edis_ratio(t2(4), t2(10))
+         do iCell = 1, nCellsSolve
+            do k = 1, nVertLevels
+               qc(1,k,iCell) = (sc(1)*edis_pc(k,iCell,1) + sc(2)*edis_pc(k,iCell,2))/dble(areaCell(iCell))
+               qc(2,k,iCell) = sc(5)*edis_pc(k,iCell,5)/dble(areaCell(iCell))
+               qc(3,k,iCell) = (edis_pc(k,iCell,3) + sc(4)*edis_pc(k,iCell,4))/dble(areaCell(iCell))
+               qc(4,k,iCell) = sc(6)*edis_pc(k,iCell,6)/dble(areaCell(iCell))
+            end do
+         end do
+         edis_pc(:,:,:) = 0.d0
+         edis_w2(:,:) = 0.d0
+      end if
+      rmax = -huge(1.d0); rmin = huge(1.d0)
+      do iCell = 1, nCellsSolve
+         do k = 1, nVertLevels
+            q(:) = qc(:,k,iCell)
+            dm = dble(rho_zz(k,iCell))/dble(rdzw(k))
+            ex = (dble(zz(k,iCell))*(dble(rgas)/dble(p0))*dble(rho_zz(k,iCell))*dble(theta_m(k,iCell)))**(dble(rgas)/dble(cv))
+            tm = dble(theta_m(k,iCell))*ex
+            call efix_set_tm(k, iCell, tm + sum(q)/(dble(cv)*dm), dt, rho_zz, theta_m, zz, rtheta_p, rtheta_b, exner, &
+                             exner_b, pressure_p, rt_diab)
+            if (met) then
+               rate = sum(q)/(dble(cv)*dm)/dble(dt)*86400.d0
+               rmax = max(rmax, rate); rmin = min(rmin, rate)
+               do n = 1, 4
+                  call ebud_radd(acc(:,n), q(n)*dble(areaCell(iCell)))
+               end do
+               call ebud_radd(acc(:,5), rate**2*dm*dble(areaCell(iCell)))
+               call ebud_radd(acc(:,6), dm*dble(areaCell(iCell)))
+            end if
+         end do
+         if (met) then
+            call ebud_radd(acc(:,7), dble(areaCell(iCell)))
+            call ebud_rnorm(acc, 9)
+         end if
+      end do
+      deallocate(qc)
+      edis_wu(:,:) = 0.0_RKIND
+      edis_wd(:,:) = 0.0_RKIND
+      edis_ww(:,:,:) = 0.d0
+      if (.not. met) return
+      call ebud_global(domain, 2, g1)
+      call ebud_rsum(domain, 9, acc, tot)
+      call mpas_dmpar_max_real(domain % dminfo, rmax, gmax)
+      call mpas_dmpar_min_real(domain % dminfo, rmin, gmin)
+      if (domain % dminfo % my_proc_id /= 0) return
+      write(0,'(a,i7,10es16.7)') 'ED ', itimestep, tot(1:4)/tot(7), &
+         (ebud_energy(g1) - ebud_energy(g0)) - sum(tot(1:4))/tot(7), gmax, gmin, sqrt(tot(5)/tot(6)), tot(8), tot(9)/tot(7)
+      if (edis_opt == 2) write(0,'(a,i7,11es16.7)') 'EP ', itimestep, t2(11)/tot(7), t2(5)/tot(7), &
+         (t2(1) - t2(11))/tot(7), t2(6)/tot(7), (t2(3) - t2(7))/tot(7), t2(8)/tot(7), t2(2)/tot(7), t2(9)/tot(7), &
+         t2(4)/tot(7), t2(10)/tot(7), t2(7)/tot(7)
+   end subroutine edis_apply
+
+   real (kind=8) function edis_ratio(h, p)
+      ! option 2 scale: a term's work over its density sum; 0 if the density vanishes (the work is left to the fixer)
+      real (kind=8), intent(in) :: h, p
+      edis_ratio = 0.d0
+      if (p > 0.d0) edis_ratio = h/p
+   end function edis_ratio
+
 end module atm_time_integration
