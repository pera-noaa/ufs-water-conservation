   use module_mp_tempo_diags, only : reflectivity_10cm, effective_radius, max_hail_diam, &
     freezing_rain
@@ -128,6 +128,8 @@ module module_mp_tempo_main
     ! thermodynamic variables
     real(wp), dimension(kts:kte) :: temp, pres, qv !! thermodynamic variables
     real(wp), dimension(kts:kte) :: rho, rhof, rhof2 !! thermodynamic variables
+    real(wp), dimension(kts:kte) :: rhon !! density after latent heating, for fall speeds only
+    real(wp) :: xcl
     real(wp), dimension(kts:kte) :: qvs, qvsi, delqvs !! thermodynamic variables
     real(wp), dimension(kts:kte) :: satw, sati, ssatw, ssati !! thermodynamic variables
     real(wp), dimension(kts:kte) :: diffu, visco, vsc2, tcond, lvap, ocp, lvt2 !! thermodynamic variables
@@ -504,12 +506,14 @@ module module_mp_tempo_main
     call sum_tendencies(rho, temp, idx_bg, lvap, ocp, tend, tten, qvten, qcten, &
       ncten, qiten, niten, qsten, qrten, nrten, qgten, ngten, qbten, qhten)
 
+    ! rho stays the entry density so sedimentation conserves the host's column mass; rhon is only for
+    ! fall speeds and ventilation
     ! update after tendencies applied ------------------------------------------------------------
     do k = 1, nz
       temp(k) = t1d(k) + tten(k)*dt
       tempc = temp(k) - t0
       qv(k) = max(min_qv, qv1d(k) + qvten(k)*dt)
-      rho(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
+      rhon(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
       nwfaten(k) = nwfaten(k) - (tend%pna_rca(k) + tend%pna_sca(k) + tend%pna_gca(k) + &
         tend%pni_iha(k)) / rho(k)
       nifaten(k) = nifaten(k) - (tend%pnd_rcd(k) + tend%pnd_scd(k) + tend%pnd_gcd(k) + tend%pni_inu(k)) / rho(k)
@@ -572,7 +576,7 @@ module module_mp_tempo_main
     xrx = qh1d
     call hail_check_and_update(rho, l_qh, xrx, rh, nh, qhten, ilamh, dt, odt)
 
-    call thermo_vars(qv, temp, pres, rho, rhof, rhof2, qvs, delqvs, qvsi, &
+    call thermo_vars(qv, temp, pres, rhon, rhof, rhof2, qvs, delqvs, qvsi, &
       satw, sati, ssatw, ssati, diffu, visco, vsc2, ocp, lvap, tcond, lvt2, &
       supersaturated)
 
@@ -602,10 +606,10 @@ module module_mp_tempo_main
       do k = 1, nz
         qv(k) = max(min_qv, qv1d(k) + qvten(k)*dt)
         temp(k) = t1d(k) + tten(k)*dt
-        rho(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
+        rhon(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
       enddo 
       
-      call thermo_vars(qv, temp, pres, rho, rhof, rhof2, qvs, delqvs, qvsi, &
+      call thermo_vars(qv, temp, pres, rhon, rhof, rhof2, qvs, delqvs, qvsi, &
       satw, sati, ssatw, ssati, diffu, visco, vsc2, ocp, lvap, tcond, lvt2, &
       supersaturated)
     endif 
@@ -630,10 +634,10 @@ module module_mp_tempo_main
       do k = 1, nz
         qv(k) = max(min_qv, qv1d(k) + qvten(k)*dt)
         temp(k) = t1d(k) + tten(k)*dt
-        rho(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
+        rhon(k) = roverrv*pres(k)/(rdry*temp(k)*(qv(k)+roverrv))
       enddo 
         
-      call thermo_vars(qv, temp, pres, rho, rhof, rhof2, qvs, delqvs, qvsi, &
+      call thermo_vars(qv, temp, pres, rhon, rhof, rhof2, qvs, delqvs, qvsi, &
         satw, sati, ssatw, ssati, diffu, visco, vsc2, ocp, lvap, tcond, lvt2, &
         supersaturated)
     endif 
@@ -807,10 +811,17 @@ module module_mp_tempo_main
     substeps_sedi = 1
     if (any(l_qc)) then
       call cloud_fallspeed(rhof, w1d, l_qc, rc, nc, ilamc, dz1d, vtrc, vtnc, ktop_sedi)
-      call sedimentation(xr=rc, vt=vtrc, dz1d=dz1d, rho=rho, xten=qcten, limit=r1, &
-        steps=substeps_sedi, ktop_sedi=ktop_sedi, precip=tempo_main_diags%cloud_precip, dt=dt)
-      call sedimentation(xr=nc, vt=vtnc, dz1d=dz1d, rho=rho, xten=ncten, limit=r2, &
-        steps=substeps_sedi, ktop_sedi=ktop_sedi, dt=dt)
+      ! substeps keep each layer's outflow within its content (Courant number <= 1), as for the other species
+      do k = 1, ktop_sedi
+        if (max(vtrc(k), vtnc(k)) > 0._wp) substeps_sedi = &
+          max(substeps_sedi, int(dt/(dz1d(k)/max(vtrc(k), vtnc(k))) + 1._wp))
+      enddo
+      do n = 1, substeps_sedi
+        call sedimentation(xr=rc, vt=vtrc, dz1d=dz1d, rho=rho, xten=qcten, limit=r1, &
+          steps=substeps_sedi, ktop_sedi=ktop_sedi, precip=tempo_main_diags%cloud_precip, dt=dt)
+        call sedimentation(xr=nc, vt=vtnc, dz1d=dz1d, rho=rho, xten=ncten, limit=r2, &
+          steps=substeps_sedi, ktop_sedi=ktop_sedi, dt=dt)
+      enddo
     endif 
 
     ! after sedimentation freeze all cloud water below hgfrz temperature
@@ -821,6 +832,46 @@ module module_mp_tempo_main
         qcten=qcten, ncten=ncten, tten=tten, ncsave=ncsave, dt=dt, odt=odt)
     endif 
 
+    ! condensate the final clips would delete is exchanged with vapour (with its latent heat) instead
+    do k = 1, nz
+      xcl = qc1d(k) + qcten(k)*dt
+      if (xcl <= r1) then
+        qcten(k) = qcten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lvap(k)*ocp(k)*xcl*odt
+      endif
+      xcl = qr1d(k) + qrten(k)*dt
+      if (xcl <= r1) then
+        qrten(k) = qrten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lvap(k)*ocp(k)*xcl*odt
+      endif
+      xcl = qi1d(k) + qiten(k)*dt
+      if (xcl <= r1) then
+        qiten(k) = qiten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lsub*ocp(k)*xcl*odt
+      endif
+      xcl = qs1d(k) + qsten(k)*dt
+      if (xcl <= r1) then
+        qsten(k) = qsten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lsub*ocp(k)*xcl*odt
+      endif
+      xcl = qg1d(k) + qgten(k)*dt
+      if (xcl <= r1) then
+        qgten(k) = qgten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lsub*ocp(k)*xcl*odt
+      endif
+      xcl = qh1d(k) + qhten(k)*dt
+      if (xcl <= r1) then
+        qhten(k) = qhten(k) - xcl*odt
+        qvten(k) = qvten(k) + xcl*odt
+        tten(k) = tten(k) - lsub*ocp(k)*xcl*odt
+      endif
+    enddo
+
     ! final update -------------------------------------------------------------------------------
     do k = 1, nz
       t1d(k)  = t1d(k) + tten(k)*dt
@@ -870,6 +921,14 @@ module module_mp_tempo_main
     call hail_check_and_update(rho, l_qh, qh1d, rh, nh, qhten, ilamh, dt, odt)
       
     ! diagnostic output --------------------------------------------------------------------------
+    ! freezing rain
+    call freezing_rain(temp=temp(1), rain_precip=tempo_main_diags%rain_precip, &
+      cloud_precip=tempo_main_diags%cloud_precip, &
+      frz_rain=tempo_main_diags%frz_rain_precip)
+
+    ! cloud water settling out of the lowest layer reaches the surface: count it as precipitation
+    tempo_main_diags%rain_precip = tempo_main_diags%rain_precip + tempo_main_diags%cloud_precip
+
     ! frozen fraction
     tempo_main_diags%frozen_fraction = &
       (tempo_main_diags%ice_liquid_equiv_precip + tempo_main_diags%snow_liquid_equiv_precip + &
@@ -882,11 +941,6 @@ module module_mp_tempo_main
     tempo_main_diags%graupel_liquid_equiv_precip = tempo_main_diags%graupel_liquid_equiv_precip + &
       tempo_main_diags%hail_liquid_equiv_precip
 
-    ! freezing rain
-    call freezing_rain(temp=temp(1), rain_precip=tempo_main_diags%rain_precip, &
-      cloud_precip=tempo_main_diags%cloud_precip, &
-      frz_rain=tempo_main_diags%frz_rain_precip)
-
     if (tempo_cfgs%cloud_number_mixing_ratio_flag) then
       allocate(tempo_main_diags%cloud_number_mixing_ratio(nz), source=nc*rho)
     endif 
@@ -1609,6 +1663,9 @@ module module_mp_tempo_main
         endif
       endif
 
+      ! below freezing, snow cannot gain more from rain-snow collection than the rain loses to it
+      if (temp(k) < t0 .and. tend%prs_rcs(k) > -tend%prr_rcs(k)) tend%prs_rcs(k) = -tend%prr_rcs(k)
+
       ! losses to snow include sublimation; melting; collection by rain; 
       ! rime splintering
       sump = tend%prs_sde(k) - tend%prs_ihm(k) - tend%prr_sml(k) + &
@@ -1660,6 +1717,14 @@ module module_mp_tempo_main
       tend%prg_rcg(k) = -tend%prr_rcg(k)
       tend%pbg_rcg(k) = meters3_to_liters*tend%prg_rcg(k)/rho_g(nrhg) ! scale density change
 
+      ! graupel gains must match the (possibly limited) losses that feed them
+      tend%prg_rci(k) = tend%pri_rci(k) + tend%prr_rci(k)
+      tend%pbg_rci(k) = meters3_to_liters*tend%prg_rci(k)/rho_g(nrhg)
+      if (temp(k) < t0) then
+        tend%prg_rcs(k) = -(tend%prr_rcs(k) + tend%prs_rcs(k))
+        tend%pbg_rcs(k) = meters3_to_liters*tend%prg_rcs(k)/rho_g(nrhg)
+      endif
+
       ! reset total rain-snow collection amount if reduced
       if (temp(k) >= t0) then
         ratio = min(abs(tend%prr_rcs(k)), abs(tend%prs_rcs(k)))
