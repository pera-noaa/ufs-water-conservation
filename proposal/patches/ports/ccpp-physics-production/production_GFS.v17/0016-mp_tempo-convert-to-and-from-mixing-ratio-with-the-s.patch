From 579f2825aa6ba67d690e3629564baae1ece84e95 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Wed, 14 Oct 2026 17:48:26 -0600
Subject: [PATCH 16/19] mp_tempo: convert to and from mixing ratio with the
 same humidity

Fix B for TEMPO's CCPP driver, as for mp_thompson. The driver converted to
mixing ratios with /(1-spechum) but back with /(1+qv_new), so every species
returned scaled by (m_d+m_v,old)/(m_d+m_v,new): net evaporation in the
scheme removed water, net condensation created it. Convert back with
*(1-spechum), the input humidity; spechum is converted in place on this
branch, so it is overwritten after the species.

Adapted to production/GFS.v17 (8007f2c3e) from proposal/scripts/apply_tempo_b_patch.py (which targets
the ufs/dev new_spechum form and aborts here).
---
 physics/MP/TEMPO/mp_tempo.F90 | 32 +++++++++++++++++---------------
 1 file changed, 17 insertions(+), 15 deletions(-)

diff --git a/physics/MP/TEMPO/mp_tempo.F90 b/physics/MP/TEMPO/mp_tempo.F90
index 174eaac2..2f5f26b7 100644
--- a/physics/MP/TEMPO/mp_tempo.F90
+++ b/physics/MP/TEMPO/mp_tempo.F90
@@ -962,27 +962,29 @@ module mp_tempo
          ! was using these arrays, but it is somewhat dangerous.
 
          !> - Convert water vapor mixing ratio back to specific humidity
-         spechum = qv/(1.0_kind_phys+qv)
-
+         ! convert back with the input (host-basis) humidity, as on entry, so the host's mass rebuild is exact;
+         ! spechum still holds the input here, so it is overwritten last
          if (convert_dry_rho) then
-           qc = qc/(1.0_kind_phys+qv)
-           qr = qr/(1.0_kind_phys+qv)
-           qi = qi/(1.0_kind_phys+qv)
-           qs = qs/(1.0_kind_phys+qv)
-           qg = qg/(1.0_kind_phys+qv)
-
-           ni = ni/(1.0_kind_phys+qv)
-           nr = nr/(1.0_kind_phys+qv)
+           qc = qc*(1.0_kind_phys-spechum)
+           qr = qr*(1.0_kind_phys-spechum)
+           qi = qi*(1.0_kind_phys-spechum)
+           qs = qs*(1.0_kind_phys-spechum)
+           qg = qg*(1.0_kind_phys-spechum)
+
+           ni = ni*(1.0_kind_phys-spechum)
+           nr = nr*(1.0_kind_phys-spechum)
            if (is_hail_aware) then
-              chw = chw/(1.0_kind_phys+qv)
-              vh  = vh/(1.0_kind_phys+qv)
+              chw = chw*(1.0_kind_phys-spechum)
+              vh  = vh*(1.0_kind_phys-spechum)
            endif
            if (is_aerosol_aware .or. merra2_aerosol_aware) then
-              nc = nc/(1.0_kind_phys+qv)
-              nwfa = nwfa/(1.0_kind_phys+qv)
-              nifa = nifa/(1.0_kind_phys+qv)
+              nc = nc*(1.0_kind_phys-spechum)
+              nwfa = nwfa*(1.0_kind_phys-spechum)
+              nifa = nifa*(1.0_kind_phys-spechum)
            end if
          end if
+
+         spechum = qv*(1.0_kind_phys-spechum)
          ! *DH
 
          !> - Convert rainfall deltas from mm to m (on physics timestep); add to inout variables
