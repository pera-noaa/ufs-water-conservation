From 55ea88e932b65ec0e465ef60efee709b3db14dd8 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Wed, 14 Oct 2026 12:04:21 -0600
Subject: [PATCH 03/18] Thompson: count settled cloud water as precipitation;
 re-close graupel gains after the limiters

C1: cloud water sedimenting out of the lowest layer (sed_c(kts)) left the
column without being added to any precipitation total. Add it to pptrain.
Cloud sedimentation also took a single full time step, unlike rain, ice,
snow and graupel, so where vtck*DT > dz (thin lowest layers, DT = 720 s)
a layer lost more cloud than it held. Substep it with the same Courant
rule as the other species; with one substep the arithmetic is unchanged.

C2: rain collecting ice and cold rain collecting snow conserve water by
construction (prg_rci = pri_rci + prr_rci; prr_rcs + prs_rcs + prg_rcs = 0)
until the clips and the ice/rain/snow rate limiters rescale the losses but
not the graupel gains. Recompute prg_rci and (below 0 C) prg_rcs after the
limiters. Below 0 C the snow gain from rain-snow collection is first capped
at the rain lost to it, so that prg_rcs cannot go negative when the rain
limiter acts.

Measured (C96 control_p8_ugwpv1, on top of the mass-basis fix): C1 takes
Thompson from -0.30 % to -0.15 % of grid-scale precipitation. C2 removes a
source that is large during spin-up (0.76 % of grid-scale precipitation in the
first 6 h of a cold start) and about 0.03 % afterwards. The substepping and
the cap remove the negative hydrometeors these two terms left at the end of
the step (2.2e-5 -> 1.3e-8 kg/m2 over 24 h, all other fixes applied).
---
 physics/MP/Thompson/module_mp_thompson.F90 | 38 ++++++++++++++++------
 1 file changed, 28 insertions(+), 10 deletions(-)

diff --git a/physics/MP/Thompson/module_mp_thompson.F90 b/physics/MP/Thompson/module_mp_thompson.F90
index 7b7d460c..8bd3c128 100644
--- a/physics/MP/Thompson/module_mp_thompson.F90
+++ b/physics/MP/Thompson/module_mp_thompson.F90
@@ -2029,6 +2029,8 @@ module module_mp_thompson
       real(wp) :: xslw1, ygra1, zans1, eva_factor
       integer :: i, k, k2, n, nn, nstep, k_0, kbot, IT, iexfrq
       integer, dimension(5) :: ksed1
+      real(wp) :: dtsed
+      integer :: nstepc
       integer :: nir, nis, nig, nii, nic, niin
       integer :: idx_tc, idx_t, idx_s, idx_g1, idx_g, idx_r1, idx_r,     &
                 idx_i1, idx_i, idx_c, idx, idx_d, idx_n, idx_in
@@ -3161,6 +3163,8 @@ module module_mp_thompson
             prr_rcs(k) = prr_rcs(k) * ratio
             prr_rcg(k) = prr_rcg(k) * ratio
          endif
+         ! snow cannot gain more from rain-snow collection than the rain loses to it
+         if (temp(k).lt.T_0 .and. prs_rcs(k).gt.-prr_rcs(k)) prs_rcs(k) = -prr_rcs(k)
 
 !>  - Snow conservation.
          sump = prs_sde(k) - prs_ihm(k) - prr_sml(k) &
@@ -3192,6 +3196,9 @@ module module_mp_thompson
          ratio = min( ABS(prr_rcg(k)), ABS(prg_rcg(k)) )
          prr_rcg(k) = ratio * SIGN(1.0, SNGL(prr_rcg(k)))
          prg_rcg(k) = -prr_rcg(k)
+         ! graupel gains must match the (possibly limited) losses that feed them
+         prg_rci(k) = pri_rci(k) + prr_rci(k)
+         if (temp(k).lt.T_0) prg_rcs(k) = -(prr_rcs(k) + prs_rcs(k))
          if (temp(k).gt.T_0) then
             ratio = min( ABS(prr_rcs(k)), ABS(prs_rcs(k)) )
             prr_rcs(k) = ratio * SIGN(1.0, SNGL(prr_rcs(k)))
@@ -4042,17 +4049,28 @@ module module_mp_thompson
 !+---+-----------------------------------------------------------------+
 
       if (ANY(L_qc .eqv. .true.)) then
-         do k = kte, kts, -1
-            sed_c(k) = vtck(k)*rc(k)
-            sed_n(k) = vtnck(k)*nc(k)
-         enddo
+         ! substeps keep each layer's outflow within its content (Courant number <= 1), as for the other species
+         nstepc = 1
          do k = ksed1(5), kts, -1
-            odzq = 1./dzq(k)
-            orho = 1./rho(k)
-            qcten(k) = qcten(k) + (sed_c(k+1)-sed_c(k)) *odzq*orho
-            ncten(k) = ncten(k) + (sed_n(k+1)-sed_n(k)) *odzq*orho
-            rc(k) = max(R1, rc(k) + (sed_c(k+1)-sed_c(k)) *odzq*DT)
-            nc(k) = max(10., nc(k) + (sed_n(k+1)-sed_n(k)) *odzq*DT)
+            if (vtck(k) .gt. 0.) nstepc = max(nstepc, int(DT*vtck(k)/dzq(k) + 1.))
+         enddo
+         onstep(5) = 1./real(nstepc, kind=wp)
+         dtsed = DT*onstep(5)
+         do n = 1, nstepc
+            do k = kte, kts, -1
+               sed_c(k) = vtck(k)*rc(k)
+               sed_n(k) = vtnck(k)*nc(k)
+            enddo
+            do k = ksed1(5), kts, -1
+               odzq = 1./dzq(k)
+               orho = onstep(5)/rho(k)
+               qcten(k) = qcten(k) + (sed_c(k+1)-sed_c(k)) *odzq*orho
+               ncten(k) = ncten(k) + (sed_n(k+1)-sed_n(k)) *odzq*orho
+               rc(k) = max(R1, rc(k) + (sed_c(k+1)-sed_c(k)) *odzq*dtsed)
+               nc(k) = max(10., nc(k) + (sed_n(k+1)-sed_n(k)) *odzq*dtsed)
+            enddo
+            ! cloud water settling out of the lowest layer reaches the surface: count it as precipitation
+            if (ksed1(5) .ge. kts) pptrain = pptrain + sed_c(kts)*dtsed
          enddo
       endif
 
