From 1aebecca2b3afa699b363aeef260456ab2f3f072 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Thu, 15 Oct 2026 09:46:03 -0600
Subject: [PATCH 2/2] Noah-MP: charge the ground's vapour at the latent heat of
 the phase it moves

energy sets the ground's latent heat from tg alone (hvap above freezing),
but water takes the ground's vapour from the snow ice (qsnsub) and puts
frost on it (qsnfro) whenever there is snow. On snow with tg > tfrz the
land paid hvap for ice it sublimated, creating hfus per kg (and the
reverse for frost): 0.13-0.61 W/m2 over a 120-day snow season in a
noahmpdrv_run harness, up to 78 W/m2 in a single call.

latheag is now hsub whenever there is snow. Where the vapour's phase still
differs from the one charged (the snow melts out within the step, or
frozen ground runs out of soil ice and gives up liquid), water returns
the difference to the top soil layer's temperature, with thermoprop's
heat capacity.

Measured: the ground's latent-energy error is zero to output precision
(<= 3e-5 W/m2 per call; season means ~1e-9) in the harness, including
randomised and melt-out stress columns; temperature returns average
0.004-0.014 K per call (max 0.14 K). Water is unchanged. In 24-h C96
control_p8_ugwpv1, water closure is unchanged; over snow-covered land the
surface keeps more energy for itself and melts less (snow cover +0.16 %,
ground heat flux +0.15 W/m2, melt heat -1.2 %).

Not covered: shortfalls inside snowh2o and combine (none occurred in any
test), and transpiration from a frozen canopy, which is charged hsub.
---
 .../SFC_Models/Land/Noahmp/module_sf_noahmplsm.F90    | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/physics/SFC_Models/Land/Noahmp/module_sf_noahmplsm.F90 b/physics/SFC_Models/Land/Noahmp/module_sf_noahmplsm.F90
index 6f6b0651..b33eac76 100644
--- a/physics/SFC_Models/Land/Noahmp/module_sf_noahmplsm.F90
+++ b/physics/SFC_Models/Land/Noahmp/module_sf_noahmplsm.F90
@@ -2227,6 +2227,8 @@ endif   ! croptype == 0
         latheag = hsub
         frozen_ground = .true.
      end if
+     ! the ground flux sublimates from, and frosts onto, the snow ice (qsnsub, qsnfro in water) whatever tg is
+     if (sneqv > 0.) latheag = hsub
      gammag = cpair*sfcprs/(ep_2*latheag)
 
 !     if (sfctmp .gt. tfrz) then
@@ -7135,6 +7137,7 @@ zolmax = xkrefsqr / sqrt(xkzo)   ! maximum z/L
   real (kind=kind_phys)                                           :: qsdew   !soil surface dew rate [mm/s]
   real (kind=kind_phys)                                           :: qsnfro  !snow surface frost rate[mm/s]
   real (kind=kind_phys)                                           :: qsnsub  !snow surface sublimation rate [mm/s]
+  real (kind=kind_phys)                                           :: lheat   !latent heat charged minus latent heat used by the ground vapour [j/m2]
   real (kind=kind_phys), dimension(       1:nsoil)                :: etrani  !transpiration rate (mm/s) [+]
   real (kind=kind_phys), dimension(       1:nsoil)                :: wcnd   !hydraulic conductivity (m/s)
   real (kind=kind_phys)                                           :: qdrain  !soil-bottom free drainage [mm/s] 
@@ -7184,15 +7187,23 @@ zolmax = xkrefsqr / sqrt(xkzo)   ! maximum z/L
           &          sh2o   ,sice   ,stc    ,zsnso  ,dzsnso , & !inout
           &          qsnbot ,snoflow,ponding1       ,ponding2)  !out
 
+   lheat = (latheag - hsub)*(qsnsub - qsnfro)*dt
    if(frozen_ground) then
       sice(1) =  sice(1) + (qsdew-qseva)*dt/(dzsnso(1)*1000.)
+      lheat = lheat + (latheag - hsub)*(qseva - qsdew)*dt
       qsdew = 0.0
       qseva = 0.0
       if(sice(1) < 0.) then
+         lheat = lheat - hfus*sice(1)*dzsnso(1)*1000.   ! the missing ice came from the liquid
          sh2o(1) = sh2o(1) + sice(1)
          sice(1) = 0.
       end if
+   else
+      lheat = lheat + (latheag - hvap)*(qseva - qsdew)*dt
    end if
+   ! the energy step charged latheag; the top soil layer gets back what the phase actually moved did not use
+   stc(1) = stc(1) + lheat / (dzsnso(1) * (sh2o(1)*cwat + (1.0-parameters%smcmax(1))*parameters%csoil  &
+                    + (parameters%smcmax(1)-sh2o(1)-sice(1))*cpair + sice(1)*cice))
 
 ! convert units (mm/s -> m/s)
 
