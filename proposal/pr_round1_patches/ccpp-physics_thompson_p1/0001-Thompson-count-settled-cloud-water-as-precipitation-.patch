From 71bcbf31e4c1566a85e237841345b56154657722 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Tue, 20 Oct 2026 20:51:04 -0500
Subject: [PATCH 1/3] Thompson: count settled cloud water as precipitation;
 substep cloud sedimentation

Cloud water sedimenting out of the lowest layer (sed_c(kts)) left the
column without being added to any precipitation total. Add it to pptrain.
Cloud sedimentation also took a single full time step, unlike rain, ice,
snow and graupel, so where vtck*DT > dz (thin lowest layers, DT = 720 s)
a layer lost more cloud than it held. Substep it with the same Courant
rule as the other species; with one substep the arithmetic is unchanged.

Measured (C96 control_p8_ugwpv1, on top of the mass-basis fix): takes
Thompson from -0.30 % to -0.15 % of grid-scale precipitation. With the
graupel re-closure's snow cap, the substepping removes the negative
hydrometeors left at the end of the step (2.2e-5 -> 1.3e-8 kg/m2 over 24 h,
all other fixes applied). In short regional cold starts counting the
settled cloud water raises reported precipitation (regional_control
+10.9 %, the atmosphere unchanged). Keeping the cloud in the lowest layer
instead conserves water too (regional_control +4.8 %).

Part of a water-conservation project for UFS physics (NOAA GML / CIRES).

AI-assisted: written with Claude Opus 5.5; reviewed by author
---
 physics/MP/Thompson/module_mp_thompson.F90 | 33 +++++++++++++++-------
 1 file changed, 23 insertions(+), 10 deletions(-)

diff --git a/physics/MP/Thompson/module_mp_thompson.F90 b/physics/MP/Thompson/module_mp_thompson.F90
index e86533ec..f663057c 100644
--- a/physics/MP/Thompson/module_mp_thompson.F90
+++ b/physics/MP/Thompson/module_mp_thompson.F90
@@ -2036,6 +2036,8 @@ module module_mp_thompson
       real(wp) :: xslw1, ygra1, zans1, eva_factor
       integer :: i, k, k2, n, nn, nstep, k_0, kbot, IT, iexfrq
       integer, dimension(5) :: ksed1
+      real(wp) :: dtsed
+      integer :: nstepc
       integer :: nir, nis, nig, nii, nic, niin
       integer :: idx_tc, idx_t, idx_s, idx_g1, idx_g, idx_r1, idx_r,     &
                 idx_i1, idx_i, idx_c, idx, idx_d, idx_n, idx_in
@@ -4053,17 +4055,28 @@ module module_mp_thompson
 !+---+-----------------------------------------------------------------+
 
       if (ANY(L_qc .eqv. .true.)) then
-         do k = kte, kts, -1
-            sed_c(k) = vtck(k)*rc(k)
-            sed_n(k) = vtnck(k)*nc(k)
-         enddo
+         ! substeps keep each layer's outflow within its content (Courant number <= 1), as for the other species
+         nstepc = 1
          do k = ksed1(5), kts, -1
-            odzq = 1./dzq(k)
-            orho = 1./rho(k)
-            qcten(k) = qcten(k) + (sed_c(k+1)-sed_c(k)) *odzq*orho
-            ncten(k) = ncten(k) + (sed_n(k+1)-sed_n(k)) *odzq*orho
-            rc(k) = max(R1, rc(k) + (sed_c(k+1)-sed_c(k)) *odzq*DT)
-            nc(k) = max(10., nc(k) + (sed_n(k+1)-sed_n(k)) *odzq*DT)
+            if (vtck(k) .gt. 0.) nstepc = max(nstepc, int(DT*vtck(k)/dzq(k) + 1.))
+         enddo
+         onstep(5) = 1./real(nstepc, kind=wp)
+         dtsed = DT*onstep(5)
+         do n = 1, nstepc
+            do k = kte, kts, -1
+               sed_c(k) = vtck(k)*rc(k)
+               sed_n(k) = vtnck(k)*nc(k)
+            enddo
+            do k = ksed1(5), kts, -1
+               odzq = 1./dzq(k)
+               orho = onstep(5)/rho(k)
+               qcten(k) = qcten(k) + (sed_c(k+1)-sed_c(k)) *odzq*orho
+               ncten(k) = ncten(k) + (sed_n(k+1)-sed_n(k)) *odzq*orho
+               rc(k) = max(R1, rc(k) + (sed_c(k+1)-sed_c(k)) *odzq*dtsed)
+               nc(k) = max(10., nc(k) + (sed_n(k+1)-sed_n(k)) *odzq*dtsed)
+            enddo
+            ! cloud water settling out of the lowest layer reaches the surface: count it as precipitation
+            if (ksed1(5) .ge. kts) pptrain = pptrain + sed_c(kts)*dtsed
          enddo
       endif
 
