From 6090bfa01126514f72e2799393fe16beee9bdc84 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Mon, 19 Oct 2026 12:24:50 -0500
Subject: [PATCH 4/6] atmosphere_state_update: apply physics heating to the
 mass it heated

The physics heats its own layer mass (dry air and vapour, condensate
excluded). fv_update_phys applies the same temperature tendency to the new
total delp, so each joule arrives multiplied by delp_new/m_physics.

Scale the temperature tendency by the ratio of the mass the physics heated
to the mass fv_update_phys heats.

Measured (C96 control_p8_ugwpv1, 24 h): coupling heating error
-8.63e-3 -> +3.9e-10 W/m2. Step 1: cloudy layers only, maximum 0.043 K;
24-h T rms 0.159 K (noise 0.149 K).

Part of a water-conservation project for UFS physics (NOAA GML / CIRES).

AI-assisted: written with Claude Opus 5.5; reviewed by author
---
 driver/UFS/atmosphere.F90 | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/driver/UFS/atmosphere.F90 b/driver/UFS/atmosphere.F90
index 4e6c0ab..6bb1dbb 100644
--- a/driver/UFS/atmosphere.F90
+++ b/driver/UFS/atmosphere.F90
@@ -1535,7 +1535,7 @@ contains
    type(time_type) :: Time_prev, Time_next
    integer :: i, j, ix, im, k, k1, n, w_diff, nt_dyn, iq
    integer :: nb, blen, nwat, dnats, nq_adv
-   real(kind=kind_phys):: rcp, q0, qwat(nq), qt, rdt
+   real(kind=kind_phys):: rcp, q0, qwat(nq), qt, rdt, qp
    real psum, qsum, psumb, qsumb, betad
    character(len=32) :: tracer_name
    Time_prev = Time
@@ -1615,7 +1615,7 @@ contains
 !$OMP                      num_gas,                                                      &
 #endif
 !$OMP                      snowwat, graupel, nq_adv, flip_vc)   &
-!$OMP             private (nb, blen, i, j, k, k1, ix, im, q0, qwat, qt, tracer_name)
+!$OMP             private (nb, blen, i, j, k, k1, ix, im, q0, qwat, qt, tracer_name, qp)
    do nb = 1,Atm_block%nblks
 
 !SJL: perform vertical filling to fix the negative humidity if the SAS convection scheme is used
@@ -1648,7 +1648,6 @@ contains
          u_dt(i,j,k1) = u_dt(i,j,k1) + (IPD_Stateout%gu0(im,k) - IPD_Statein%ugrs(im,k)) * rdt
          v_dt(i,j,k1) = v_dt(i,j,k1) + (IPD_Stateout%gv0(im,k) - IPD_Statein%vgrs(im,k)) * rdt
 !         t_dt(i,j,k1) = (IPD_Stateout%gt0(im,k) - IPD_Statein%tgrs(im,k)) * rdt
-         t_dt(i,j,k1) = t_dt(i,j,k1) + (IPD_Stateout%gt0(im,k) - IPD_Statein%tgrs(im,k)) * rdt
 ! SJL notes:
 ! ---- DO not touch the code below; dry mass conservation may change due to 64bit <-> 32bit conversion
 ! DH notes:
@@ -1663,6 +1662,7 @@ contains
            q0 = IPD_Statein%prsi(im,k+1) - IPD_Statein%prsi(im,k)
          endif
          qwat(1:nq_adv) = q0*IPD_Stateout%gq0(im,k,1:nq_adv)
+         qp = q0
 ! **********************************************************************************************************
 ! Dry mass: the following way of updating delp is key to mass conservation with hybrid 32-64 bit computation
 ! **********************************************************************************************************
@@ -1675,6 +1675,8 @@ contains
          q0 = Atm(n)%delp(i,j,k1)*(1.-sum(Atm(n)%q(i,j,k1,1:nwat))) + qt
 #endif
          Atm(n)%delp(i,j,k1) = q0
+! physics heated its own layer mass qp (condensate excluded); fv_update_phys heats the new delp
+         t_dt(i,j,k1) = t_dt(i,j,k1) + (IPD_Stateout%gt0(im,k) - IPD_Statein%tgrs(im,k)) * rdt * qp / q0
          Atm(n)%q(i,j,k1,1:nq_adv) = qwat(1:nq_adv) / q0
 !        if (dnats .gt. 0) Atm(n)%q(i,j,k1,nq_adv+1:nq) = IPD_Stateout%gq0(im,k,nq_adv+1:nq)
        enddo
