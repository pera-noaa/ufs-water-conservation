+!>@brief dry_tracer_mask: tracers advected and remapped as dry mixing ratios when dry_tracer_adv is set,
+!! i.e. field_table tracers with "tracer_usage","chemistry" that are not "type=diagnostic" (never water 1..nwat).
+subroutine dry_tracer_mask(on, nq, nwat, dry_tr)
+   logical, intent(in) :: on
+   integer, intent(in) :: nq, nwat
+   logical, intent(out) :: dry_tr(nq)
+   character(len=32) :: usage
+   character(len=128) :: control
+   integer :: iq
+   dry_tr(:) = .false.
+   if ( .not. on ) return
+   do iq=nwat+1,nq
+      if ( query_method('tracer_usage', MODEL_ATMOS, iq, usage, control) ) then
+         dry_tr(iq) = trim(usage) == 'chemistry' .and. index(control, 'diagnostic') == 0
+      endif
+   enddo
+end subroutine dry_tracer_mask
+
+!>@brief dry_sw: sum of the water species (tracers 1..nwat) at level k on the data domain.
+subroutine dry_sw(q, npz, nq, k, nwat, sw, bd)
+   type(fv_grid_bounds_type), intent(IN) :: bd
+   integer, intent(in) :: npz, nq, k, nwat
+   real, intent(in) :: q(bd%isd:bd%ied,bd%jsd:bd%jed,npz,nq)
+   real, intent(out) :: sw(bd%isd:bd%ied,bd%jsd:bd%jed)
+   integer :: i, j, m
+   sw(:,:) = 0.
+   do m=1,nwat
+      do j=bd%jsd,bd%jed
+         do i=bd%isd,bd%ied
+            sw(i,j) = sw(i,j) + q(i,j,k,m)
+         enddo
+      enddo
+   enddo
+end subroutine dry_sw
+
+!>@brief dry_flux: dry-air mass flux = total mass flux minus the (limited) water-species fluxes, summed in fixed order.
+subroutine dry_flux(mfx, mfy, fxw, fyw, nwat, fdx, fdy, bd)
+   type(fv_grid_bounds_type), intent(IN) :: bd
+   integer, intent(in) :: nwat
+   real, intent(in) :: mfx(bd%is:bd%ie+1,bd%js:bd%je), mfy(bd%is:bd%ie,bd%js:bd%je+1)
+   real, intent(in) :: fxw(bd%is:bd%ie+1,bd%js:bd%je,*), fyw(bd%is:bd%ie,bd%js:bd%je+1,*)
+   real, intent(out) :: fdx(bd%is:bd%ie+1,bd%js:bd%je), fdy(bd%is:bd%ie,bd%js:bd%je+1)
+   integer :: i, j, m
+   fdx(:,:) = mfx(:,:)
+   fdy(:,:) = mfy(:,:)
+   do m=1,nwat
+      do j=bd%js,bd%je
+         do i=bd%is,bd%ie+1
+            fdx(i,j) = fdx(i,j) - fxw(i,j,m)
+         enddo
+      enddo
+      do j=bd%js,bd%je+1
+         do i=bd%is,bd%ie
+            fdy(i,j) = fdy(i,j) - fyw(i,j,m)
+         enddo
+      enddo
+   enddo
+end subroutine dry_flux
+
+!>@brief dry_tracer_bc_to_q: in the boundary halo of a bounded domain (outside 1..npx-1, 1..npy-1) the dry tracers
+!! were just set from BCs that hold the dry ratio c; convert to q = c*(1 - sum water), water being the BC water there.
+subroutine dry_tracer_bc_to_q(q, npx, npy, npz, nq, nwat, dry_tr, bd)
+   type(fv_grid_bounds_type), intent(IN) :: bd
+   integer, intent(in) :: npx, npy, npz, nq, nwat
+   logical, intent(in) :: dry_tr(nq)
+   real, intent(inout) :: q(bd%isd:bd%ied,bd%jsd:bd%jed,npz,nq)
+   real :: sw
+   integer :: i, j, k, m, iq
+   if ( bd%is > 1 .and. bd%ie < npx-1 .and. bd%js > 1 .and. bd%je < npy-1 ) return
+   do iq=1,nq
+      if ( .not. dry_tr(iq) ) cycle
+      do k=1,npz
+         do j=bd%jsd,bd%jed
+            do i=bd%isd,bd%ied
+               if ( i < 1 .or. i > npx-1 .or. j < 1 .or. j > npy-1 ) then
+                  sw = 0.
+                  do m=1,nwat
+                     sw = sw + q(i,j,k,m)
+                  enddo
+                  q(i,j,k,iq) = q(i,j,k,iq)*(1.-sw)
+               endif
+            enddo
+         enddo
+      enddo
+   enddo
+end subroutine dry_tracer_bc_to_q
+
+!>@brief dry_negadj: neg_adj2/3/4 fill negative water by borrowing it from other layers at fixed delp, which moves
+!! dry air between layers without moving the tracers. mode 0 saves the layer water masses w = delp*sum(water);
+!! mode 1 moves each dry tracer with the implied downward dry-air flux G(k+1/2) = sum_{j<=k} dW_j (upwind dry ratio,
+!! flux form, zero at top and bottom), then saves the new water masses. A uniform dry ratio stays uniform; tracer
+!! mass is conserved exactly. Columns where neg_adj did not move water are unchanged.
+subroutine dry_negadj(mode, q, delp, wsav, isd, ied, jsd, jed, is, ie, js, je, npz, nq, nwat, dry_tr)
+   integer, intent(in) :: mode, isd, ied, jsd, jed, is, ie, js, je, npz, nq, nwat
+   logical, intent(in) :: dry_tr(nq)
+   real, intent(inout) :: q(isd:ied,jsd:jed,npz,nq)
+   real, intent(in) :: delp(isd:ied,jsd:jed,npz)
+   real, intent(inout) :: wsav(is:ie,js:je,npz)
+   real :: wnew(npz), dw(npz), g(0:npz), c(npz)
+   integer :: i, j, k, m, iq
+   logical :: moved
+!$OMP parallel do default(none) shared(mode,q,delp,wsav,is,ie,js,je,npz,nq,nwat,dry_tr) &
+!$OMP                          private(i,k,m,iq,wnew,dw,g,c,moved)
+   do j=js,je
+      do i=is,ie
+         do k=1,npz
+            wnew(k) = 0.
+            do m=1,nwat
+               wnew(k) = wnew(k) + q(i,j,k,m)
+            enddo
+            wnew(k) = wnew(k)*delp(i,j,k)
+         enddo
+         if ( mode == 1 ) then
+            moved = .false.
+            do k=1,npz
+               dw(k) = wnew(k) - wsav(i,j,k)
+               if ( dw(k) /= 0. ) moved = .true.
+            enddo
+            if ( moved ) then
+               g(0) = 0.
+               do k=1,npz-1
+                  g(k) = g(k-1) + dw(k)
+               enddo
+               g(npz) = 0.
+               do iq=1,nq
+                  if ( .not. dry_tr(iq) ) cycle
+                  do k=1,npz   ! dry ratio before neg_adj (old water)
+                     c(k) = q(i,j,k,iq)*delp(i,j,k)/(delp(i,j,k) - wsav(i,j,k))
+                  enddo
+                  do k=1,npz
+                     q(i,j,k,iq) = ( q(i,j,k,iq)*delp(i,j,k)                                        &
+                                   + g(k-1)*merge(c(max(k-1,1)), c(k), g(k-1) > 0.)                 &
+                                   - g(k)  *merge(c(k), c(min(k+1,npz)), g(k) > 0.) ) / delp(i,j,k)
+                  enddo
+               enddo
+            endif
+         endif
+         do k=1,npz
+            wsav(i,j,k) = wnew(k)
+         enddo
+      enddo
+   enddo
+end subroutine dry_negadj
