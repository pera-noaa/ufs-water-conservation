+      integer, intent(in):: km, i1, i2, kord
+      real(kind=R_GRID), intent(in):: pe1(i1:i2,km+1), pe2(i1:i2,km+1), dp2(i1:i2,km)
+      real, intent(in):: c1(i1:i2,km)
+      real(kind=R_GRID), intent(out):: q2(i1:i2,km)
+      real   qs(i1:i2)
+      real   dp1r(i1:i2,km)
+      real   q4(4,i1:i2,km)
+      real(kind=R_GRID):: dp1(i1:i2,km), pl, pr, qsum, dp, esl
+      integer i, k, l, m, k0
+
+      do k=1,km
+         do i=i1,i2
+            dp1(i,k) = pe1(i,k+1) - pe1(i,k)
+            dp1r(i,k) = dp1(i,k)
+            q4(1,i,k) = c1(i,k)
+         enddo
+      enddo
+      if ( kord >7 ) then
+         call scalar_profile( qs, q4, dp1r, km, i1, i2, 0, kord, 0. )
+      else
+         call ppm_profile( q4, dp1r, km, i1, i2, 0, kord )
+      endif
+
+      do 1000 i=i1,i2
+         k0 = 1
+      do 555 k=1,km
+      do 100 l=k0,km
+      if(pe2(i,k) >= pe1(i,l) .and. pe2(i,k) <= pe1(i,l+1)) then
+         pl = (pe2(i,k)-pe1(i,l)) / dp1(i,l)
+         if(pe2(i,k+1) <= pe1(i,l+1)) then
+            pr = (pe2(i,k+1)-pe1(i,l)) / dp1(i,l)
+            q2(i,k) = q4(2,i,l) + 0.5*(q4(4,i,l)+q4(3,i,l)-q4(2,i,l))  &
+                       *(pr+pl)-q4(4,i,l)*r3*(pr*(pr+pl)+pl**2)
+               k0 = l
+               goto 555
+          else
+            qsum = (pe1(i,l+1)-pe2(i,k))*(q4(2,i,l)+0.5*(q4(4,i,l)+   &
+                    q4(3,i,l)-q4(2,i,l))*(1.+pl)-q4(4,i,l)*           &
+                     (r3*(1.+pl*(1.+pl))))
+              do m=l+1,km
+                 if(pe2(i,k+1) > pe1(i,m+1) ) then
+                    qsum = qsum + dp1(i,m)*q4(1,i,m)
+                 else
+                     dp = pe2(i,k+1)-pe1(i,m)
+                    esl = dp / dp1(i,m)
+                   qsum = qsum + dp*(q4(2,i,m)+0.5*esl*               &
+                       (q4(3,i,m)-q4(2,i,m)+q4(4,i,m)*(1.-r23*esl)))
+                   k0 = m
+                   goto 123
+                 endif
+              enddo
+              goto 123
+          endif
+      endif
+100   continue
+123   q2(i,k) = qsum / dp2(i,k)
+555   continue
+1000  continue
+
+ end subroutine map1_dry
+
