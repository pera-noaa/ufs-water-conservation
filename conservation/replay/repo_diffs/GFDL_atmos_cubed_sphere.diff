+      ! net downward water flux through the top of each layer (Pa); ftop(npz+1) = P - E
+      ftop(1) = 0.
+      do k1 = 1, npz
+         ftop(k1+1) = ftop(k1) - dm(k1)
+      enddo
+      qse(:) = 0.
+      do k1 = 1, npz
+         qpe(k1) = 0.5*(ftop(k1) + ftop(k1+1))*(phib(k1) - phib(k1+1))
+         qfw(k1) = rvgas*tk(k1)*dmv(k1)
+      enddo
+      ! precipitation through the bottom of dycore layer k1 (Pa); residual net flux (vapour) by its direction
+      do k1 = 1, npz
+         k = k1
+         if (flip_vc) k = npz+1-k1
+         fpl(k1+1) = grav*(IPD_Stateout%pflx_dc(im,k) + IPD_Stateout%pflx_sc(im,k) + IPD_Stateout%pflx_mpl(im,k))
+         fpi(k1+1) = grav*IPD_Stateout%pflx_mpi(im,k)
+         fbl(k1+1) = grav*IPD_Stateout%pflx_pbll(im,k)
+         fbi(k1+1) = grav*IPD_Stateout%pflx_pbli(im,k)
+      enddo
+      do k1 = 1, npz-1
+         qse(k1+1) = qse(k1+1) - (fpl(k1+1)*c_liq + fpi(k1+1)*c_ice)*(tk(k1+1) - tk(k1))
+         ! PBL condensate transport: c_l/c_i exchange in the receiving layer
+         if (fbl(k1+1) + fbi(k1+1) >= 0.) then
+            qse(k1+1) = qse(k1+1) - (fbl(k1+1)*c_liq + fbi(k1+1)*c_ice)*(tk(k1+1) - tk(k1))
+         else
+            qse(k1) = qse(k1) - (fbl(k1+1)*c_liq + fbi(k1+1)*c_ice)*(tk(k1+1) - tk(k1))
+         endif
+         fr = ftop(k1+1) - fpl(k1+1) - fpi(k1+1) - fbl(k1+1) - fbi(k1+1)
+         if (fr >= 0.) then
+            qse(k1+1) = qse(k1+1) - fr*cp_vapor*(tk(k1+1) - tk(k1))
+         else
+            qse(k1) = qse(k1) - fr*cp_vapor*(tk(k1+1) - tk(k1))
+         endif
+      enddo
+      do k1 = 1, npz
+         e = 0.
+         if (iand(ibits, 1) /= 0) e = e + qpe(k1)
+         if (iand(ibits, 2) /= 0) e = e + qfw(k1)
+         if (iand(ibits, 4) /= 0) e = e + qse(k1)
+         if (iand(ibits, 8) /= 0) e = e - dm(k1)*ked(k1)
+         ! fv_update_phys injects cp_air*t_dt*dt*delp_new/grav
+         t_dt(i,j,k1) = t_dt(i,j,k1) + e*rdt/(cp_air*dpn(k1))
+      enddo
+   enddo
+ end subroutine cpl_water_energy
+
 end module atmosphere_mod
