+         if (frame_heat) then
+           ! heating from the net phase change of each layer (water budget + exported precipitation fluxes,
+           ! vapour flux = remainder) at FV3's latent heats L(T) for the step-initial T, replacing Thompson's
+           do fi = 1, ncol
+             ftt = 0.0_kind_phys
+             do fk = nlev, 1, -1
