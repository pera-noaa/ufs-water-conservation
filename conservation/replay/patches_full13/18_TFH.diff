+               fit = 0.0_kind_phys
+               if (fk < nlev) fit = pflx_mpi(fi,fk+1)
+               fvb = ftb - pflx_mpl(fi,fk) - fib
+               fvt = ftt
+               if (fk < nlev) fvt = ftt - pflx_mpl(fi,fk+1) - fit
+               fqa = fvt - fvb - fdv                ! vapour condensed or deposited in the layer
+               fqb = fdi - (fit - fib)              ! water frozen (from vapour or liquid) in the layer
+               fqreq = (lvap0_tfh + (1846.0_kind_phys - 4185.5_kind_phys)*(t_old(fi,fk) - 273.15_kind_phys))*fqa &
+                     + (lfus_tfh + (4185.5_kind_phys - 1972.0_kind_phys)*(t_old(fi,fk) - 273.15_kind_phys))*fqb
+               new_tgrs(fi,fk) = tgrs(fi,fk) + fqreq/(Cp_tfh*fmass)
+               ftt = ftb
+             enddo
