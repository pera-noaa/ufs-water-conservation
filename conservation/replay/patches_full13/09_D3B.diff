@@ -3943,6 +3945,45 @@
       endif
       endif ! (.not.hwrf_samfdeep)
 
+!> - CMT dissipative heating (samf_cmt_heat), Boville-Bretherton interface form: momentum moved
+!!   across each interface x time-centred shear, half to each adjacent layer; column total = -d(KE)
+      if (samf_cmt_heat) then
+        do i = 1, im
+          if (cnvflg(i)) then
+            cmtu = 0.0_conv_wp
+            cmtv = 0.0_conv_wp
+            do k = 1, km
+              cmtq(k) = 0.0_conv_wp
+            enddo
+            do k = km, 2, -1
+              cmtu = cmtu - real(delp(i,k), kind=conv_wp)
+     &             * (new_u1(i,k) - real(u1(i,k), kind=conv_wp))
+              cmtv = cmtv - real(delp(i,k), kind=conv_wp)
+     &             * (new_v1(i,k) - real(v1(i,k), kind=conv_wp))
+              tem = 0.5_conv_wp * (cmtu * (new_u1(i,k)
+     &            + real(u1(i,k), kind=conv_wp) - new_u1(i,k-1)
+     &            - real(u1(i,k-1), kind=conv_wp))
+     &            + cmtv * (new_v1(i,k)
+     &            + real(v1(i,k), kind=conv_wp) - new_v1(i,k-1)
+     &            - real(v1(i,k-1), kind=conv_wp)))
+              cmtq(k)   = cmtq(k)   + 0.5_conv_wp * tem
+              cmtq(k-1) = cmtq(k-1) + 0.5_conv_wp * tem
+            enddo
+            cmtu = cmtu - real(delp(i,1), kind=conv_wp)
+     &           * (new_u1(i,1) - real(u1(i,1), kind=conv_wp))
+            cmtv = cmtv - real(delp(i,1), kind=conv_wp)
+     &           * (new_v1(i,1) - real(v1(i,1), kind=conv_wp))
+            cmtq(1) = cmtq(1) + 0.5_conv_wp * (cmtu * (new_u1(i,1)
+     &              + real(u1(i,1), kind=conv_wp)) + cmtv
+     &              * (new_v1(i,1) + real(v1(i,1), kind=conv_wp)))
+            do k = 1, km
+              new_t1(i,k) = new_t1(i,k) + cmtq(k)
+     &          / (real(cp, kind=conv_wp)
+     &          * real(delp(i,k), kind=conv_wp))
+            enddo
+          endif
+        enddo
+      endif
       ten_t = real((new_t1 - real(t1, kind=conv_wp)) / real(delt,
      &        kind=conv_wp), kind=kind_phys)
       ten_q(:,:,1) = real((new_q1 - real(q1, kind=conv_wp))
