+
+!> Water closure (gf_closure): raincv is the water GF's applied tendencies remove from the column (host layer
+!! mass). Where they would add water instead, the positive increments are reduced in proportion to zero net.
+      subroutine gf_column_water(im, km, dt, g, prsi, tqv, dcliw, dclcw, raincv)
+      integer, intent(in) :: im, km
+      real(kind=kind_phys), intent(in) :: dt, g, prsi(:,:)
+      real(kind=kind_phys), intent(inout) :: tqv(:,:), dcliw(:,:), dclcw(:,:)
+      real(kind=kind_phys), intent(out) :: raincv(:)
+      real(kind=kind_phys) :: m, dw, pos, f
+      integer :: i, k
+      do i = 1, im
+        dw = 0.
+        pos = 0.
+        do k = 1, km
+          m = (prsi(i,k) - prsi(i,k+1))/g
+          dw = dw + (tqv(i,k) + dcliw(i,k) + dclcw(i,k))*m
+          pos = pos + (max(tqv(i,k), 0.) + max(dcliw(i,k), 0.) + max(dclcw(i,k), 0.))*m
+        enddo
+        if (dw > 0. .and. pos > 0.) then
+          f = 1. - dw/pos
+          dw = 0.
+          do k = 1, km
+            if (tqv(i,k) > 0.) tqv(i,k) = tqv(i,k)*f
+            if (dcliw(i,k) > 0.) dcliw(i,k) = dcliw(i,k)*f
+            if (dclcw(i,k) > 0.) dclcw(i,k) = dclcw(i,k)*f
+            dw = dw + (tqv(i,k) + dcliw(i,k) + dclcw(i,k))*(prsi(i,k) - prsi(i,k+1))/g
+          enddo
+        endif
+        raincv(i) = max(0., -dw*dt*0.001)
+      enddo
+      end subroutine gf_column_water
 end module cu_gf_driver
