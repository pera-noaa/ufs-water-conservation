+   elemental real(wp) function ls_t(t)
+      !< latent heat of sublimation applied to T (lsub unless thompson_kirchhoff)
+      real(wp), intent(in) :: t
+      ls_t = lsub + dls*(t - 273.15)
+   end function ls_t
+
+   elemental real(wp) function lf_t(t)
+      !< latent heat of melting applied to T (lfus unless thompson_kirchhoff)
+      real(wp), intent(in) :: t
