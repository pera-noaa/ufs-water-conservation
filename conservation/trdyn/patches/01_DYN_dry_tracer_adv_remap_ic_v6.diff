+      real:: cd(i1:i2,km,ndry)
+      real:: q2(i1:i2,km), q2f(i1:i2,km), ddr(i1:i2,km)
+      real(kind=R_GRID):: pd1(i1:i2,km+1), pd2(i1:i2,km+1), dd2(i1:i2,km), c2(i1:i2,km)
+      real(kind=R_GRID):: sw, rat
+      integer:: idx(ndry)
+      integer:: i, k, n, iq
+
+      n = 0
+      do iq=1,nq
+         if ( dry_tr(iq) ) then
+            n = n + 1
+            idx(n) = iq
+         endif
+      enddo
+
+! dry ratio and dry-pressure edges of the Lagrangian layers
+      do i=i1,i2
+         pd1(i,1) = 0.
+      enddo
+      do k=1,km
+         do i=i1,i2
+            sw = 0.
+            do iq=1,nwat
+               sw = sw + q1(i,j,k,iq)
+            enddo
+            do n=1,ndry
+               cd(i,k,n) = q1(i,j,k,idx(n))/(1.-sw)
+            enddo
+            pd1(i,k+1) = pd1(i,k) + (real(pe1(i,k+1),R_GRID)-real(pe1(i,k),R_GRID))*(1.-sw)
+         enddo
+      enddo
+
+! all tracers as without dry_tracer_adv
