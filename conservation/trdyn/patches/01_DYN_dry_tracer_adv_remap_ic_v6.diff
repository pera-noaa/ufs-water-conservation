+!>@brief dry_tracer_bc_to_q: in the boundary halo of a bounded domain (outside 1..npx-1, 1..npy-1) the dry tracers
+!! were just set from BCs that hold the dry ratio c; convert to q = c*(1 - sum water), water being the BC water there.
+subroutine dry_tracer_bc_to_q(q, npx, npy, npz, nq, nwat, dry_tr, bd)
+   type(fv_grid_bounds_type), intent(IN) :: bd
+   integer, intent(in) :: npx, npy, npz, nq, nwat
+   logical, intent(in) :: dry_tr(nq)
+   real, intent(inout) :: q(bd%isd:bd%ied,bd%jsd:bd%jed,npz,nq)
+   real :: sw
+   integer :: i, j, k, m, iq
+   if ( bd%is > 1 .and. bd%ie < npx-1 .and. bd%js > 1 .and. bd%je < npy-1 ) return
+   do iq=1,nq
+      if ( .not. dry_tr(iq) ) cycle
+      do k=1,npz
+         do j=bd%jsd,bd%jed
+            do i=bd%isd,bd%ied
+               if ( i < 1 .or. i > npx-1 .or. j < 1 .or. j > npy-1 ) then
+                  sw = 0.
+                  do m=1,nwat
+                     sw = sw + q(i,j,k,m)
+                  enddo
+                  q(i,j,k,iq) = q(i,j,k,iq)*(1.-sw)
+               endif
+            enddo
+         enddo
+      enddo
+   enddo
+end subroutine dry_tracer_bc_to_q
