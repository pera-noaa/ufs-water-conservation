 !>@brief The subroutine 'adiabatic_init' is an optional step during initialization
 !! to pre-condition a solution via backward-forward steps with capability for various
 !! nudgings.
+!>@brief dry_tracer_ic_save: keep the chemistry tracers of the cold-start IC as dry mixing ratios (dry_tracer_ic).
+ subroutine dry_tracer_ic_save()
+   logical :: msk(ncnst)
+   integer :: iq, n
+   call dry_tracer_mask(.true., nq, Atm(mygrid)%flagstruct%nwat, msk(1:nq))
+   n = count(msk(1:nq))
+   allocate ( dry_ic_idx(n), dry_ic_c(isc:iec,jsc:jec,npz,n) )
+   n = 0
+   do iq=1,nq
+      if ( msk(iq) ) then
+         n = n + 1
+         dry_ic_idx(n) = iq
+         dry_ic_c(:,:,:,n) = Atm(mygrid)%q(isc:iec,jsc:jec,1:npz,iq)
+      endif
+   enddo
+   if ( is_master() ) write(*,*) 'dry_tracer_ic: ', n, ' chemistry tracers read as dry mixing ratios'
+ end subroutine dry_tracer_ic_save
+
+!>@brief dry_tracer_ic_set: after adiabatic_init, q = (IC dry ratio)*(1 - sum of the model's water species).
+ subroutine dry_tracer_ic_set()
+   integer :: i, j, k, m, n, iq, nwat
+   real :: sw
+   nwat = Atm(mygrid)%flagstruct%nwat
+   do n=1,size(dry_ic_idx)
+      iq = dry_ic_idx(n)
+      do k=1,npz
+         do j=jsc,jec
+            do i=isc,iec
+               sw = 0.
+               do m=1,nwat
+                  sw = sw + Atm(mygrid)%q(i,j,k,m)
+               enddo
+               Atm(mygrid)%q(i,j,k,iq) = dry_ic_c(i,j,k,n)*(1.-sw)
+            enddo
+         enddo
+      enddo
+      call mpp_update_domains(Atm(mygrid)%q(:,:,:,iq), Atm(mygrid)%domain)
+   enddo
+   deallocate ( dry_ic_c, dry_ic_idx )
+ end subroutine dry_tracer_ic_set
+
