  end subroutine mapn_tracer
+
+
+!>@brief mapn_tracer_dry: remap all tracers as in Lagrangian_to_Eulerian (water results unchanged), then remap the
+!! dry tracers' dry ratio c = q/(1-sum water) over dry-air thickness: old layers dp1*(1-old water), new layers
+!! dp2*(1-remapped water), edges rescaled to the old column dry mass. Returns q = c*D2/dp2, so a uniform c stays
+!! uniform and sum(q*dp) is conserved as by the moist remap.
+ subroutine mapn_tracer_dry(nq, nwat, ndry, km, pe1, pe2, q1, dp2, kord, j,     &
+                            i1, i2, isd, ied, jsd, jed, fill, dry_tr)
+      integer, intent(in):: km, j, nq, nwat, ndry, i1, i2, isd, ied, jsd, jed
+      integer, intent(in):: kord(nq)
+      real, intent(in)::  pe1(i1:i2,km+1)
+      real, intent(in)::  pe2(i1:i2,km+1)
+      real, intent(in)::  dp2(i1:i2,km)
+      logical, intent(in):: fill
+      logical, intent(in):: dry_tr(nq)
+      real, intent(inout):: q1(isd:ied,jsd:jed,km,nq)
+! LOCAL VARIABLES:
+      real:: cd(i1:i2,km,ndry)
+      real:: q2(i1:i2,km), dd2(i1:i2,km)
+      real:: pd1(i1:i2,km+1), pd2(i1:i2,km+1)
+      real:: sw(i1:i2)
+      real:: rat
+      integer:: idx(ndry)
+      integer:: i, k, n, iq
+
+      n = 0
+      do iq=1,nq
+         if ( dry_tr(iq) ) then
+            n = n + 1
+            idx(n) = iq
+         endif
+      enddo
+
+! dry ratio and dry-pressure edges of the Lagrangian layers
+      do i=i1,i2
+         pd1(i,1) = 0.
+      enddo
+      do k=1,km
+         do i=i1,i2
+            sw(i) = 0.
+         enddo
+         do iq=1,nwat
+            do i=i1,i2
+               sw(i) = sw(i) + q1(i,j,k,iq)
+            enddo
+         enddo
+         do n=1,ndry
+            do i=i1,i2
+               cd(i,k,n) = q1(i,j,k,idx(n))/(1.-sw(i))
+            enddo
+         enddo
+         do i=i1,i2
+            pd1(i,k+1) = pd1(i,k) + (pe1(i,k+1)-pe1(i,k))*(1.-sw(i))
+         enddo
+      enddo
+
+! all tracers as without dry_tracer_adv
+      if( nq > 5 ) then
+         call mapn_tracer(nq, km, pe1, pe2, q1, dp2, kord, j,     &
+                          i1, i2, isd, ied, jsd, jed, 0., fill)
+      else
+         do iq=1,nq
+            call map1_q2(km, pe1, q1(isd,jsd,1,iq),     &
+                         km, pe2, q2, dp2,             &
+                         i1, i2, 0, kord(iq), j, isd, ied, jsd, jed, 0.)
+            if (fill) call fillz(i2-i1+1, km, 1, q2, dp2)
+            do k=1,km
+               do i=i1,i2
+                  q1(i,j,k,iq) = q2(i,k)
+               enddo
+            enddo
+         enddo
+      endif
+
+! dry-pressure edges of the Eulerian layers from the remapped water
+      do i=i1,i2
+         pd2(i,1) = 0.
+      enddo
+      do k=1,km
+         do i=i1,i2
+            sw(i) = 0.
+         enddo
+         do iq=1,nwat
+            do i=i1,i2
+               sw(i) = sw(i) + q1(i,j,k,iq)
+            enddo
+         enddo
+         do i=i1,i2
+            pd2(i,k+1) = pd2(i,k) + dp2(i,k)*(1.-sw(i))
+         enddo
+      enddo
+      do i=i1,i2
+         rat = pd1(i,km+1)/pd2(i,km+1)
+         do k=2,km
+            pd2(i,k) = pd2(i,k)*rat
+         enddo
+         pd2(i,km+1) = pd1(i,km+1)
+      enddo
+      do k=1,km
+         do i=i1,i2
+            dd2(i,k) = pd2(i,k+1) - pd2(i,k)
+         enddo
+      enddo
+
+      do n=1,ndry
+         iq = idx(n)
+         do k=1,km
+            do i=i1,i2
+               q1(i,j,k,iq) = cd(i,k,n)
+            enddo
+         enddo
+         call map1_q2(km, pd1, q1(isd,jsd,1,iq),     &
+                      km, pd2, q2, dd2,              &
+                      i1, i2, 0, kord(iq), j, isd, ied, jsd, jed, 0.)
+         if (fill) call fillz(i2-i1+1, km, 1, q2, dd2)
+         do k=1,km
+            do i=i1,i2
+               q1(i,j,k,iq) = q2(i,k)*dd2(i,k)/dp2(i,k)
+            enddo
+         enddo
+      enddo
+
+ end subroutine mapn_tracer_dry
 
 
