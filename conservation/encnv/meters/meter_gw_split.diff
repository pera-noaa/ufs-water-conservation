+!> \file em_gw.F90
+!! GWD-segment split meter (diagnostic builds only).
+module em_gw
+  use machine, only: kind_phys
+  use energy_meter_common, only: emy
+  implicit none
+contains
+!> \section arg_table_em_gw_run Argument Table
+!! \htmlinclude em_gw_run.html
+!!
+  subroutine em_gw_run(im, levs, dtp, gu0, gv0, dudt, dvdt, dudt_gw, dvdt_gw, dtdt_gw, dudt_ngw,  &
+       dvdt_ngw, dtdt_ngw, prsi, garea, con_g, con_cp, errmsg, errflg)
+    integer, intent(in) :: im
+    integer, intent(in) :: levs
+    real(kind=kind_phys), intent(in) :: dtp
+    real(kind=kind_phys), intent(in) :: gu0(:,:)
+    real(kind=kind_phys), intent(in) :: gv0(:,:)
+    real(kind=kind_phys), intent(in) :: dudt(:,:)
+    real(kind=kind_phys), intent(in) :: dvdt(:,:)
+    real(kind=kind_phys), intent(in) :: dudt_gw(:,:)
+    real(kind=kind_phys), intent(in) :: dvdt_gw(:,:)
+    real(kind=kind_phys), intent(in) :: dtdt_gw(:,:)
+    real(kind=kind_phys), intent(in) :: dudt_ngw(:,:)
+    real(kind=kind_phys), intent(in) :: dvdt_ngw(:,:)
+    real(kind=kind_phys), intent(in) :: dtdt_ngw(:,:)
+    real(kind=kind_phys), intent(in) :: prsi(:,:)
+    real(kind=kind_phys), intent(in) :: garea(:)
+    real(kind=kind_phys), intent(in) :: con_g
+    real(kind=kind_phys), intent(in) :: con_cp
+    character(len=*), intent(out) :: errmsg
+    integer, intent(out) :: errflg
+    integer :: i, k
+    real(kind=8) :: m, a, u0, v0, ue, ve, du, dv, dug, dvg, dun, dvn, kg, hg, e(8)
+    do i = 1, im
+       e = 0.d0
+       a = garea(i)
+       do k = 1, levs
+          m = (prsi(i,k) - prsi(i,k+1))/con_g
+          u0 = gu0(i,k)
+          v0 = gv0(i,k)
+          ue = u0 + dtp*dudt(i,k)
+          ve = v0 + dtp*dvdt(i,k)
+          du = dtp*dudt_gw(i,k)
+          dv = dtp*dvdt_gw(i,k)
+          dun = dtp*dudt_ngw(i,k)
+          dvn = dtp*dvdt_ngw(i,k)
+          dug = dtp*(dudt_gw(i,k) - dudt_ngw(i,k))
+          dvg = dtp*(dvdt_gw(i,k) - dvdt_ngw(i,k))
+          kg = dug*(u0 + 0.5d0*dug) + dvg*(v0 + 0.5d0*dvg)
+          hg = con_cp*dtp*(dtdt_gw(i,k) - dtdt_ngw(i,k))
+          e(1) = e(1) + m*(du*(ue + 0.5d0*du) + dv*(ve + 0.5d0*dv))
+          e(2) = e(2) + m*kg
+          e(3) = e(3) + m*(dun*(u0 + 0.5d0*dun) + dvn*(v0 + 0.5d0*dvn))
+          e(4) = e(4) + m*hg
+          e(5) = e(5) + m*con_cp*dtp*dtdt_ngw(i,k)
+          e(6) = e(6) + m*(du*(ue - u0) + dv*(ve - v0))
+          e(7) = e(7) + m*(dug*dun + dvg*dvn)
+          e(8) = e(8) + m*abs(hg + kg)
+       enddo
+       emy = emy + e*a
+    enddo
+    errmsg = ''
+    errflg = 0
+  end subroutine em_gw_run
+end module em_gw

