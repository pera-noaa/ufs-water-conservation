@@ -717,6 +722,32 @@
 !       endif
 
     end if   ! do_ugwp_v1
+!
+! ngw_heat_opt = 1: NGW heating is the KE loss of its own wind increment only
+! ngw_heat_opt = 2: keep it; withdraw the column's net NGW energy input at the launch level
+!
+    if (do_ugwp_v1 .and. ngw_heat_opt == 1) then
+      do k=1,levs
+        do i=1,im
+          dtdt_ngw(i,k) = -( dudt_ngw(i,k)*(ugrs(i,k) + 0.5*dtp*dudt_ngw(i,k))          &
+                           + dvdt_ngw(i,k)*(vgrs(i,k) + 0.5*dtp*dvdt_ngw(i,k)) )/con_cp
+        enddo
+      enddo
+    else if (do_ugwp_v1 .and. ngw_heat_opt == 2) then
+      do i=1,im
+        ngwe = 0.
+        do k=1,levs
+          ngwe = ngwe + del(i,k)*( con_cp*dtdt_ngw(i,k)                                  &
+                 + dudt_ngw(i,k)*(ugrs(i,k) + 0.5*dtp*dudt_ngw(i,k))                    &
+                 + dvdt_ngw(i,k)*(vgrs(i,k) + 0.5*dtp*dvdt_ngw(i,k)) )
+        enddo
+        do kl=1,levs
+          if (prsl(i,kl) < knob_ugwp_palaunch) exit
+        enddo
+        kl = max(kl-1, 3)     ! launch layer, as in cires_ugwpv1_ngw_solv2
+        dtdt_ngw(i,kl) = dtdt_ngw(i,kl) - ngwe/(con_cp*del(i,kl))
+      enddo
+    endif
 
     if(ldiag3d .and. lssav .and. .not. flag_for_gwd_generic_tend) then
       idtend = dtidx(index_of_x_wind,index_of_process_nonorographic_gwd)
