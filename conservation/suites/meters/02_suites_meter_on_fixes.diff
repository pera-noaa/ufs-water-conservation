+!> \file smg_p03.F90
+!! Suites meter probe 3 (diagnostic builds only).
+module smg_p03
+  use machine, only: kind_phys
+  use suites_meter_common
+  implicit none
+contains
+!> \section arg_table_smg_p03_run Argument Table
+!! \htmlinclude smg_p03_run.html
+!!
+  subroutine smg_p03_run(im, levs, kdt, dtp, gt0, gq0, gu0, gv0, dtdt, dqdt, dudt, dvdt, prsi, ntqv, ntcw,  &
+       ntiw, ntrw, ntsw, ntgl, con_g, con_cp, con_hvap, con_hfus, xlon, xlat, dtsfc1,  &
+       dqsfc1, errmsg, errflg)
+    integer, intent(in) :: im
+    integer, intent(in) :: levs
+    integer, intent(in) :: kdt
+    real(kind=kind_phys), intent(in) :: dtp
+    real(kind=kind_phys), intent(in) :: gt0(:,:)
+    real(kind=kind_phys), intent(in) :: gq0(:,:,:)
+    real(kind=kind_phys), intent(in) :: gu0(:,:)
+    real(kind=kind_phys), intent(in) :: gv0(:,:)
+    real(kind=kind_phys), intent(in) :: dtdt(:,:)
+    real(kind=kind_phys), intent(in) :: dqdt(:,:,:)
+    real(kind=kind_phys), intent(in) :: dudt(:,:)
+    real(kind=kind_phys), intent(in) :: dvdt(:,:)
+    real(kind=kind_phys), intent(in) :: prsi(:,:)
+    integer, intent(in) :: ntqv
+    integer, intent(in) :: ntcw
+    integer, intent(in) :: ntiw
+    integer, intent(in) :: ntrw
+    integer, intent(in) :: ntsw
+    integer, intent(in) :: ntgl
+    real(kind=kind_phys), intent(in) :: con_g
+    real(kind=kind_phys), intent(in) :: con_cp
+    real(kind=kind_phys), intent(in) :: con_hvap
+    real(kind=kind_phys), intent(in) :: con_hfus
+    real(kind=kind_phys), intent(in) :: xlon(:)
+    real(kind=kind_phys), intent(in) :: xlat(:)
+    real(kind=kind_phys), intent(in) :: dtsfc1(:)
+    real(kind=kind_phys), intent(in) :: dqsfc1(:)
+    character(len=*), intent(out) :: errmsg
+    integer, intent(out) :: errflg
+    integer :: j0, i, j, p
+
+    call sm_probe(3, im, levs, kdt, dtp, gt0, gq0, gu0, gv0, dtdt, dqdt, dudt, dvdt, prsi, &
+                  ntqv, ntcw, ntiw, ntrw, ntsw, ntgl, con_g, con_cp, con_hvap, con_hfus, xlon, xlat, j0)
+    p = 3
+    do i = 1, im
+       j = j0 + i
+       smf(1, p, j) = dtp*dtsfc1(i)
+       smf(2, p, j) = dtp*dqsfc1(i)/con_hvap
+    enddo
+
+    errmsg = ''
+    errflg = 0
+  end subroutine smg_p03_run
+end module smg_p03

