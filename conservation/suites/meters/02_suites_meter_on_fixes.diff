+    character(len=*), intent(out) :: errmsg
+    integer, intent(out) :: errflg
+    integer :: j0, i, j, p
+
+    call sm_probe(5, im, levs, kdt, dtp, gt0, gq0, gu0, gv0, dtdt, dqdt, dudt, dvdt, prsi, &
