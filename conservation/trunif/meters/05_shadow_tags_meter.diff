+       v(ix) = tm_sha(3,ip,iq); lk(ix) = tm_sha(4,ip,iq); la(ix) = tm_sha(5,ip,iq); lo(ix) = tm_sha(6,ip,iq)
+     enddo
+   enddo
+   call mpp_sum(s, 2*nn)
+   vl = v; call mpp_max(v, nn)
+   where (vl /= v)
+     lk = -1.d30; la = -1.d30; lo = -1.d30
+   end where
+   call mpp_max(lk, nn); call mpp_max(la, nn); call mpp_max(lo, nn)
