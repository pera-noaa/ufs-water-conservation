#!/bin/bash
#SBATCH -A co2 -p service -n 1 -t 02:00:00 -J r15tr_setup
#SBATCH -o /work2/noaa/co2/ash/ufs-chem-v1/upstream/cons/r15_mlm/trace/logs/setup.%j.log
# r15 trace: src_p = src_fix + fix_v2 + probes; src_0 = src_fix + fix_v2; src_gp = src_fix + guards_only + probes
set -euo pipefail
U=/work2/noaa/co2/ash/ufs-chem-v1/upstream; T=$U/cons/r15_mlm/trace; B=$U/meterproto/src_fix; R=$U/cons/r15_mlm
PY="env -u PYTHONPATH PYTHONNOUSERSITE=1 /work2/noaa/co2/micromamba/envs/ccgg/bin/python3 -I"
for t in src_p src_0 src_gp; do [ -e $T/$t ] && { echo "ABORT $t exists"; exit 1; }; done
md5sum $R/fix_v2.diff $R/guards_only.diff $T/bin/apply_probe.py
for t in src_p src_0 src_gp; do
  rsync -a --exclude='/tests/*.exe' --exclude='/tests/build_*' --exclude='/build/' --exclude='/tests/logs/log_*' --exclude='/tests/run_dir' --exclude='/tests/modules.fv3_*' --exclude='/tests/fail_test_*' $B/ $T/$t/
done
cd $T/src_p/UFSATM/ccpp/physics && patch -p1 --forward < $R/fix_v2.diff
cd $T/src_0/UFSATM/ccpp/physics && patch -p1 --forward < $R/fix_v2.diff
cd $T/src_gp/UFSATM/ccpp/physics && patch -p1 --forward < $R/guards_only.diff
$PY $T/bin/apply_probe.py $T/src_p
$PY $T/bin/apply_probe.py $T/src_gp
for t in src_p src_0 src_gp; do
  for f in UFSATM/ccpp/physics/physics/PBL/SATMEDMF/mfscuq_mlm.f UFSATM/ccpp/physics/physics/PBL/SATMEDMF/satmedmfvdifq.F UFSATM/ccpp/driver/GFS_budget.F90; do
    diff -u $B/$f $T/$t/$f || true
  done > $T/logs/$t.diff
  echo "$t: $(grep -c '^[-+][^-+]' $T/logs/$t.diff) changed lines; physics git: $(cd $T/$t/UFSATM/ccpp/physics && git status --short | grep -v '^??' | tr '\n' ' ')"
done
awk 'length > 72 && !/^[!cC]/ {print FILENAME": "FNR": "length}' $T/src_p/UFSATM/ccpp/physics/physics/PBL/SATMEDMF/satmedmfvdifq.F $T/src_p/UFSATM/ccpp/physics/physics/PBL/SATMEDMF/mfscuq_mlm.f | head
echo "SETUP_OK $(date -Is)"
